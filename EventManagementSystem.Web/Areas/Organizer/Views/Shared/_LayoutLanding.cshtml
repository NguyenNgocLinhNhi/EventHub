<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eventus - Professional Event Solutions</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
        /* Đồng bộ font chữ Arimo cho toàn bộ ứng dụng */
        body, h1, h2, h3, h4, h5, h6, p, a, span, button, input, li {
            font-family: 'Arimo', sans-serif;
        }

        .text-teal {
            color: #00786F;
        }

        .nav-link {
            color: #364153 !important;
            font-weight: 500;
            transition: color 0.3s;
        }

            .nav-link:hover {
                color: #00786F !important;
            }

        .btn-emerald {
            background: #00786F;
            color: white;
            border-radius: 30px;
            border: none;
            font-weight: 500;
        }

            .btn-emerald:hover {
                background: #005f5a;
                color: white;
            }

        .btn-outline-emerald {
            border: 1px solid #00786F;
            color: #00786F;
            border-radius: 30px;
            font-weight: 500;
        }

            .btn-outline-emerald:hover {
                background: #00786F;
                color: white;
            }

        /* Mobile Optimization */
        @@media (max-width: 991.98px) {
            .navbar-collapse

        {
            background: white;
            padding: 1rem;
            border-radius: 10px;
            box-shadow: 0 10px 15px rgba(0,0,0,0.1);
            margin-top: 10px;
        }

        .nav-auth-buttons {
            flex-direction: column;
            gap: 10px;
            margin-top: 15px;
        }

            .nav-auth-buttons a {
                width: 100%;
                text-align: center;
            }

        }

        .footer-link {
            transition: all 0.3s ease;
        }

            .footer-link:hover {
                color: #26c6da !important;
                padding-left: 5px;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-teal" asp-area="Organizer" asp-controller="Home" asp-action="Index">Eventus</a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-area="Organizer" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-area="Organizer" asp-controller="Home" asp-action="About">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-area="Organizer" asp-controller="Home" asp-action="Services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-area="Organizer" asp-controller="Home" asp-action="Events">Events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-area="Organizer" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex nav-auth-buttons">
                    <a href="/Organizer/Account/Login" class="btn btn-outline-emerald px-4 me-lg-2">Log in</a>
                    <a href="/Organizer/Account/Register" class="btn btn-emerald px-4">Get Started</a>
                </div>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-3" style="background-color: #0b1619 !important;">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-4">Eventus</h5>
                    <p class="text-secondary small">
                        Comprehensive event management solutions helping you optimize ticketing, manage guests, and boost your revenue.
                    </p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm text-white border-secondary">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm text-white border-secondary">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle shadow-sm text-white border-secondary">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;">Contact Us</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill text-info me-2"></i>
                            Quang Trung Software City, District 12, HCMC
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-telephone-fill text-info me-2"></i>
                            +84 123 456 789
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-envelope-fill text-info me-2"></i>
                            support@eventus.com
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;">Quick Links</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-2"><a href="/Organizer/Home/About" class="text-decoration-none text-secondary footer-link">About Us</a></li>
                        <li class="mb-2"><a href="/Organizer/Home/Contact" class="text-decoration-none text-secondary footer-link">Contact</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-secondary footer-link">Privacy Policy</a></li>
                        <li class="mb-2"><a href="/Organizer/Account/Login" class="text-decoration-none text-secondary footer-link text-info">Admin Login</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;">Services</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-2">Interface Ecosystem</li>
                        <li class="mb-2">Revenue Management</li>
                        <li class="mb-2">Check-in Operations</li>
                        <li class="mb-2">Real-time Reporting</li>
                    </ul>
                </div>
            </div>

            <hr class="mt-5 mb-4 border-secondary opacity-25">

            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="text-secondary small mb-0">
                        &copy; 2026 Eventus. All Rights Reserved.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <ul class="list-inline mb-0 small">
                        <li class="list-inline-item me-3"><a href="#" class="text-decoration-none text-secondary footer-link">Home</a></li>
                        <li class="list-inline-item me-3"><a href="#" class="text-decoration-none text-secondary footer-link">Cookies</a></li>
                        <li class="list-inline-item"><a href="#" class="text-decoration-none text-secondary footer-link">FAQs</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>