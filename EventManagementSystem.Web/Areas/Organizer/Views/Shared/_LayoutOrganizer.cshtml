@using EventManagementSystem.Web.Data
@using EventManagementSystem.Web.Models.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var orgData = await _context.OrganizationInfos.FirstOrDefaultAsync();

    // 1. Lấy danh sách ID các sự kiện thuộc về NTC này
    var myEventIds = _context.Events
                        .Where(e => e.OrganizerId == currentUser.Id)
                        .Select(e => e.Id)
                        .ToList();

    // 2. Lấy thắc mắc mới (ContactInquiries)
    var contactNotes = (from i in _context.ContactInquiries
                        where myEventIds.Contains(i.EventId ?? 0) && !i.IsReadByOrganizer
                        select new
                        {
                            Id = i.Id,
                            Title = "New inquiry: " + i.Subject,
                            Time = i.CreatedAt,
                            Url = Url.Action("Index", "ContactInquiry", new { area = "Organizer" }),
                            Icon = "bi-chat-left-text text-success",
                            Type = "Inquiry"
                        }).ToList<dynamic>();

    // 3. Lấy thông báo mua vé mới (Đơn hàng Confirmed chưa đọc)
    var bookingNotes = (from b in _context.Bookings
                        where myEventIds.Contains(b.EventId) && b.Status == "Confirmed" && !b.IsReadByOrganizer
                        select new
                        {
                            Id = b.Id,
                            Title = "New purchase: " + b.CustomerName,
                            Time = b.BookingDate,
                            Url = Url.Action("Index", "Ticket", new { area = "Organizer" }),
                            Icon = "bi-cart-check text-primary",
                            Type = "Booking"
                        }).ToList<dynamic>();

    // 4. Lấy thông báo hủy vé mới (Vé IsCancelled chưa đọc)
    var cancelNotes = (from d in _context.BookingDetails
                       where myEventIds.Contains(d.Booking.EventId) && d.IsCancelled && !d.IsReadByOrganizer
                       select new
                       {
                           Id = d.Id,
                           Title = "Ticket Void: " + d.SeatNumber + " (" + d.Booking.CustomerName + ")",
                           Time = d.CancelledAt ?? DateTime.Now, // Thay DateTime.Now bằng trường dữ liệu thực tế
                           Url = Url.Action("Index", "Ticket", new { area = "Organizer" }),
                           Icon = "bi-x-circle text-danger",
                           Type = "Cancellation"
                       }).ToList<dynamic>();

    // 5. Gộp tất cả và sắp xếp theo thời gian mới nhất
    var allNotifications = contactNotes.Concat(bookingNotes).Concat(cancelNotes)
                           .OrderByDescending(n => n.Time)
                           .Take(10).ToList();

    int totalUnreadCount = allNotifications.Count;

    // Phản hồi từ Admin (Giữ nguyên logic cũ)
    int unreadSupportCount = _context.ContactInquiries
        .Count(i => i.UserId == currentUser.Id && i.EventId == null && i.IsReplied && !i.IsReadByAttendee);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventHub organizer</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body { 
            font-family: 'Arimo', sans-serif;
            background-color: #f4f7f6; 
            overflow-x: hidden; 
            margin: 0; 
            color: #333;
        }
        
        .sidebar { 
            min-width: 280px;
            max-width: 280px;
            height: 100vh; 
            background-color: #00786F;
            color: #ffffff; 
            position: fixed;
            top: 0;
            left: 0;
            transition: all 0.3s;
            z-index: 1000;
        }
        
        .sidebar-header {
            padding: 30px 25px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .sidebar-header small {
                font-size: 13px !important; /* Tăng kích thước */
                font-weight: 600 !important; /* Làm đậm hơn */
                color: rgba(255, 255, 255, 0.8) !important; /* Màu trắng rõ hơn */
            }

        /* Tinh chỉnh font-weight và màu sắc cho nav-link */
        .sidebar .nav-link { 
            color: #ffffff; /* Màu chữ trắng rõ nét hơn thay vì rgba */
            margin: 5px 15px; 
            padding: 12px 20px; 
            border-radius: 10px;
            display: flex;
            align-items: center;
            font-size: 15px;
            font-weight: 600; /* Làm chữ đậm hơn một chút */
            transition: all 0.2s;
            font-family: 'Arimo', sans-serif;
        }
        
        .sidebar .nav-link i { 
            font-size: 1.2rem;
            width: 30px; 
            opacity: 0.9; /* Biểu tượng rõ hơn */
        }
        
        .sidebar .nav-link:hover, .sidebar .nav-link.active { 
            background: rgba(255,255,255,0.2); /* Nền hover đậm hơn một chút */
            color: #ffffff !important; 
            font-weight: 800; /* Đậm hẳn khi active hoặc hover */
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 20px 15px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .user-info { 
            padding: 10px 15px;
            display: flex; 
            align-items: center; 
            gap: 12px; 
        }
        
        .user-info i { 
            font-size: 24px;
            color: #ffffff; 
        }

        .user-info .text-white-50 {
        font-size: 13px !important; /* Tăng kích thước từ 11px lên 13px */
        font-weight: 500 !important; /* Làm chữ đậm vừa phải để dễ đọc */
        color: rgba(255, 255, 255, 0.8) !important; /* Tăng độ hiển thị màu sắc */
        margin-top: 2px;
        }

        .user-info .fw-bold {
            font-size: 15px;
            color: #ffffff;
        }

        .main-wrapper {
            margin-left: 280px;
            width: calc(100% - 280px);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content-area { 
            padding: 25px 40px;
            flex: 1;
        }

        .text-danger-custom {
            color: #ff8787 !important; /* Màu đỏ sáng hơn để dễ nhìn trên nền xanh */
            font-weight: 700;
        }

        .badge.bg-danger {
            animation: pulse-red 2s infinite;
        }

        @@keyframes pulse-red {
            0%

        {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 8px rgba(220, 53, 69, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }

        }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar shadow d-flex flex-column">
            <div class="sidebar-header">
                <div class="d-flex align-items-center">
                    <i class="bi bi-calendar4-event fs-2 me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-0">EventHub</h4>
                        <small class="text-white-50">Organizer panel</small>
                    </div>
                </div>
            </div>
            
            <ul class="nav flex-column mt-4">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                       asp-area="Organizer" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Event" && ViewContext.RouteData.Values["Action"]?.ToString() != "LandingPageGallery" ? "active" : "")" 
                       asp-area="Organizer" asp-controller="Event" asp-action="Index">
                        <i class="bi bi-calendar-event"></i> Event management
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ticket" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                       asp-area="Organizer" asp-controller="Ticket" asp-action="Index">
                        <i class="bi bi-ticket-perforated"></i> Ticket management
                    </a>               
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "LandingPageGallery" ? "active" : "")" 
                       asp-area="Organizer" asp-controller="Event" asp-action="LandingPageGallery">
                        <i class="bi bi-layout-text-window-reverse"></i> Landing page gallery
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Customers" ? "active" : "")" 
                       asp-area="Organizer" asp-controller="Ticket" asp-action="Customers">
                        <i class="bi bi-people"></i> Customer management
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")" 
                       asp-area="Organizer" asp-controller="Report" asp-action="Revenue">
                        <i class="bi bi-currency-dollar"></i> Revenue report
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ContactInquiry" ? "active" : "")"
                       asp-area="Organizer" asp-controller="ContactInquiry" asp-action="Index">
                        <i class="bi bi-chat-dots"></i> Customer Inquiries
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Support" ? "active" : "")"
                       asp-area="Organizer" asp-controller="Support" asp-action="Index">
                        <div class="d-flex align-items-center w-100 justify-content-between">
                            <div>
                                <i class="bi bi-headset me-2"></i>
                                <span>System Help</span>
                            </div>
                            @if (unreadSupportCount > 0)
                            {
                                <span class="badge rounded-pill bg-danger shadow-sm"
                                      style="font-size: 0.7rem; padding: 0.4em 0.6em;">
                                    @unreadSupportCount
                                </span>
                            }
                        </div>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                @if (currentUser != null)
                {
                    <div class="user-info mb-3">
                        <i class="bi bi-person-circle text-white"></i>
                        <div class="overflow-hidden">
                            <p class="small fw-bold mb-0 text-truncate">@(orgData?.OrganizationName ?? "Organization")</p>
                            <p class="text-white-50 mb-0 text-truncate" style="font-size: 11px;">@currentUser.Email</p>
                        </div>
                    </div>
                }
                
                <a class="nav-link mb-2 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" 
                   asp-area="Organizer" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear me-2"></i> Settings
                </a>
                
                <form asp-area="Organizer" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right text-danger-custom"></i> <span class="text-danger-custom">Logout</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="main-wrapper">
            <header class="d-flex align-items-center justify-content-end px-4 shadow-sm bg-white" style="height: 70px;">
                <div class="dropdown me-3">
                    <button class="btn btn-link p-0 position-relative text-dark" id="orgNotifDrop" data-bs-toggle="dropdown">
                        <i class="bi bi-bell fs-4"></i>
                        @if (totalUnreadCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                @totalUnreadCount
                            </span>
                        }
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-3 p-0" style="width: 320px;">
                        <div class="p-3 border-bottom bg-light rounded-top-4">
                            <h6 class="fw-bold mb-0">Notifications</h6>
                        </div>
                        <div style="max-height: 350px; overflow-y: auto;">
                            @if (!allNotifications.Any())
                            {
                                <div class="p-4 text-center text-muted small">
                                    <i class="bi bi-bell-slash d-block fs-3 mb-2"></i>
                                    No new notifications
                                </div>
                            }
                            else
                            {
                                @foreach (var note in allNotifications)
                                {
                                    <div class="notification-item position-relative border-bottom" id="org-note-@note.Type-@note.Id">
                                        <a href="@note.Url" class="dropdown-item p-3 d-flex align-items-start gap-3" onclick="markAsRead('@note.Type', @note.Id)">
                                            <div class="bg-light p-2 rounded-3"><i class="bi @note.Icon"></i></div>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <p class="mb-1 text-dark fw-bold small text-wrap">@note.Title</p>
                                                <small class="text-muted">@note.Time.ToString("dd/MM HH:mm")</small>
                                            </div>
                                        </a>
                                        <button class="btn-close position-absolute top-50 end-0 translate-middle-y me-2"
                                                style="font-size: 0.7rem;" onclick="dismissNotification('@note.Type', @note.Id)"></button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    function markAsRead(type, id) {
        // Gửi yêu cầu cập nhật trạng thái đã đọc dựa trên loại thông báo
    $.post('/Organizer/Notification/MarkRead', { type: type, id: id }, function (res) {
                if (res.success) {
                    removeNotificationUI(type, id);
            }
        });
    }

    function dismissNotification(type, id) {
        event.preventDefault();
        event.stopPropagation();
        $.post('/Organizer/Notification/MarkRead', { type: type, id: id }, function (res) {
            if (res.success) {
                removeNotificationUI(type, id);
            }
        });
    }

    function removeNotificationUI(type, id) {
        $(`#org-note-${type}-${id}`).fadeOut(300, function() {
            $(this).remove();
            let countBadge = $('#orgNotifDrop .badge');
            if (countBadge.length) {
                let currentCount = parseInt(countBadge.text());
                if (currentCount > 1) {
                    countBadge.text(currentCount - 1);
                } else {
                    countBadge.remove();
                    // Nếu hết thông báo, hiện dòng chữ "No new notifications"
                    if ($('.notification-item').length === 0) {
                        $('.dropdown-menu div[style*="max-height"]').html('<div class="p-4 text-center text-muted small"><i class="bi bi-bell-slash d-block fs-3 mb-2"></i>No new notifications</div>');
                    }
                }
            }
        });
    }
</script>