@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "Check Your Email";
}

<div class="py-5 d-flex align-items-center" style="background-color: #f8f9fa; min-height: 80vh;">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-lg rounded-4 p-5">
                    <div class="mb-4">
                        <i class="fas fa-envelope-open-text fa-5x text-muted"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Check Your Email</h2>
                    <p class="text-muted mb-4">
                        We have sent a confirmation link to your registered email address.
                        Please check your inbox (and your Spam folder) to activate your Organizer account.
                    </p>
                    <div class="small">
                        Didn't receive the email? 
                        <a href="#" class="fw-bold text-teal">Resend request</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>