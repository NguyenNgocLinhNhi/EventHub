@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Customer management";
    Layout = "~/Areas/Organizer/Views/Shared/_LayoutOrganizer.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4" style="font-family: 'Arimo', sans-serif;">
    <h2 class="fw-bold mb-0">My Customers</h2>
    <button class="btn btn-primary rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#emailModal">
        <i class="bi bi-envelope-paper me-2"></i> Send bulk Notification
    </button>
</div>

<div class="card border-0 shadow-sm p-3 mb-4 rounded-4" style="font-family: 'Arimo', sans-serif;">
    <div class="row g-3">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="customerSearch" class="form-control border-start-0 shadow-none"
                       placeholder="Search by ID, Name, Phone or Email...">
            </div>
        </div>
        <div class="col-md-4">
            <select id="rankFilter" class="form-select shadow-none">
                <option value="">-- All Ranks --</option>
                <option value="Diamond">Diamond (> 10m)</option>
                <option value="Gold">Gold (5m - 10m)</option>
                <option value="Silver">Silver (1m - 5m)</option>
                <option value="Bronze">Bronze (< 1m)</option>
            </select>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="font-family: 'Arimo', sans-serif;">
    <table class="table align-middle mb-0 table-hover">
        <thead class="bg-light text-muted small fw-bold">
            <tr>
                <th class="ps-4 py-3">Customer ID</th>
                <th>Customer Name</th>
                <th>Rank</th>
                <th>Phone number</th>
                <th>Email address</th>
                <th class="text-end pe-4">Action</th>
            </tr>
        </thead>
        <tbody id="customerTableBody">
            @foreach (var item in Model)
            {
                var displayId = "#" + (((int)item.IntId % 1000).ToString("D3"));
                var rankClass = item.Rank switch
                {
                    "Diamond" => "bg-danger text-white",
                    "Gold" => "bg-warning text-dark",
                    "Silver" => "bg-info text-white",
                    _ => "bg-secondary text-white"
                };

                <tr class="customer-row" data-rank="@item.Rank">
                    <td class="ps-4">
                        <span class="badge bg-light text-dark border fw-bold">@displayId</span>
                    </td>
                    <td class="fw-bold text-primary">@item.CustomerName</td>
                    <td>
                        <span class="badge @rankClass rounded-pill px-3">@item.Rank</span>
                    </td>
                    <td>@(string.IsNullOrEmpty(item.CustomerPhone) ? "---" : item.CustomerPhone)</td>
                    <td>@item.CustomerEmail</td>
                    <td class="text-end pe-4">
                        <div class="btn-group border rounded-3 overflow-hidden shadow-sm">
                            <button type="button" class="btn btn-sm btn-white border-end btn-history"
                                    data-email="@item.CustomerEmail" data-name="@item.CustomerName" title="View Order history">
                                <i class="bi bi-eye text-primary"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white btn-customer-detail"
                                    data-email="@item.CustomerEmail" data-name="@item.CustomerName"
                                    data-phone="@item.CustomerPhone" title="Details & Joined Events">
                                <i class="bi bi-pencil-square text-warning"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" style="font-family: 'Arimo', sans-serif;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold">Order history: <span id="historyCustomerName" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="historyContent"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerDetailModal" tabindex="-1" style="font-family: 'Arimo', sans-serif;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light border-0 pt-4 px-4">
                <h5 class="modal-title fw-bold mb-0">Customer details: <span id="detName" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-4 bg-white p-3 rounded-3 border mx-0">
                    <div class="col-md-6 border-end">
                        <p class="mb-1 small text-muted text-uppercase fw-bold">Contact Email</p>
                        <p class="mb-0 fw-bold" id="detEmail"></p>
                    </div>
                    <div class="col-md-6 ps-md-4">
                        <p class="mb-1 small text-muted text-uppercase fw-bold">Phone number</p>
                        <p class="mb-0 fw-bold" id="detPhone"></p>
                    </div>
                </div>
                <div id="eventParticipationList"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="emailModal" tabindex="-1" style="font-family: 'Arimo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold">Send Notification for new Events</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Subject</label>
                    <input type="text" id="emailSubject" class="form-control" placeholder="Enter subject...">
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Message Content</label>
                    <textarea id="emailBody" class="form-control" rows="5" placeholder="Write message to Customers..."></textarea>
                </div>
                <button type="button" class="btn btn-primary w-100 rounded-3 py-2 fw-bold shadow-sm" id="btnConfirmSend">
                    <i class="bi bi-send me-2"></i>Send now to all Customers
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function filterTable() {
                var searchText = $("#customerSearch").val().toLowerCase();
                var selectedRank = $("#rankFilter").val();

                $("#customerTableBody tr").each(function () {
                    var rowText = $(this).text().toLowerCase();
                    var rowRank = $(this).data("rank");
                    var matchesSearch = rowText.indexOf(searchText) > -1;
                    var matchesRank = selectedRank === "" || rowRank === selectedRank;
                    $(this).toggle(matchesSearch && matchesRank);
                });
            }

            $("#customerSearch").on("keyup", filterTable);
            $("#rankFilter").on("change", filterTable);

            $(".btn-history").click(function () {
                var email = $(this).data("email");
                $("#historyCustomerName").text($(this).data("name"));
                $("#historyModal").modal("show");
                $("#historyContent").html('<div class="text-center p-5"><div class="spinner-border text-primary"></div></div>');
                $.get("/Organizer/Ticket/GetCustomerHistory?email=" + encodeURIComponent(email), function (data) {
                    $("#historyContent").html(data);
                });
            });

            $(".btn-customer-detail").click(function () {
                var email = $(this).data("email");
                var name = $(this).data("name");
                var phone = $(this).data("phone") || "---";

                $("#detName").text(name);
                $("#detEmail").text(email);
                $("#detPhone").text(phone);
                $("#eventParticipationList").html('<div class="text-center p-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>');
                $("#customerDetailModal").modal("show");

                $.get("/Organizer/Ticket/GetCustomerDetails?email=" + encodeURIComponent(email), function (data) {
                    var html = `
                        <div class="alert alert-primary border-0 rounded-3 d-flex justify-content-between align-items-center mb-4 shadow-sm">
                            <span class="fw-bold"><i class="bi bi-cash-stack me-2"></i>Total accumulated spending:</span>
                            <span class="fs-5 fw-bold">${data.totalSpent.toLocaleString()}đ</span>
                        </div>
                        <h6 class="fw-bold mb-3"><i class="bi bi-calendar-check me-2"></i>Registered Events</h6>`;

                    if (data.events.length === 0) {
                        html += "<p class='text-muted small ps-3'>No Events joined yet.</p>";
                    } else {
                        data.events.forEach(function (ev) {
                            html += `
                                <div class='card mb-3 border rounded-3 p-3 shadow-sm'>
                                    <div class='d-flex justify-content-between align-items-center mb-2'>
                                        <span class='fw-bold text-dark'>${ev.eventTitle}</span>
                                        <span class='badge bg-light text-muted border fw-normal'>${new Date(ev.eventDate).toLocaleDateString('en-US')}</span>
                                    </div>
                                    <div class='ps-2 border-start border-3 border-primary'>`;
                            ev.tickets.forEach(function (tk) {
                                html += `
                                    <div class='small d-flex justify-content-between py-1'>
                                        <span>${tk.ticketName} <b class='text-dark'>x${tk.quantity}</b></span>
                                        <span class='fw-bold'>${tk.price.toLocaleString()}đ</span>
                                    </div>`;
                            });
                            html += `</div></div>`;
                        });
                    }
                    $("#eventParticipationList").html(html);
                });
            });

            $("#btnConfirmSend").click(function() {
                var btn = $(this);
                var data = { subject: $("#emailSubject").val(), body: $("#emailBody").val() };
                if(!data.subject || !data.body) { alert("Please fill in all fields!"); return; }
                btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span>Sending...');
                $.post("/Organizer/Ticket/SendBulkEmail", data, function(res) {
                    if(res.success) {
                        alert("Sent successfully to " + res.count + " Customers!");
                        $("#emailModal").modal("hide");
                    }
                    btn.prop("disabled", false).html('<i class="bi bi-send me-2"></i>Send now');
                });
            });
        });
    </script>
}

<style>
    body {
        font-family: 'Arimo', sans-serif;
    }

    .btn-white {
        background: white;
        border: none;
        padding: 0.5rem 0.75rem;
    }

        .btn-white:hover {
            background: #f8f9fa;
        }

    .btn-group .btn i {
        font-size: 1.1rem;
    }

    .customer-row {
        transition: background 0.2s;
    }

        .customer-row:hover {
            background-color: #fbfcfe !important;
        }
</style>