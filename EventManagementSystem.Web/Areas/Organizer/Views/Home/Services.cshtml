@{
    ViewData["Title"] = "Solutions & services - Eventus";
    Layout = "_LayoutLanding";
}

<style>
    /* 1. ĐỒNG BỘ HỆ THỐNG FONT */
    body, h1, h2, h3, h4, h5, h6, p, a, span, button, li, .accordion-button {
        font-family: 'Arimo', sans-serif;
    }

    /* 2. HERO SECTION - ĐỒNG BỘ TUYỆT ĐỐI VỚI INDEX */
    .service-hero {
        background: linear-gradient(rgba(0, 77, 64, 0.85), rgba(0, 77, 64, 0.85)), url('https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=1920&q=80');
        background-size: cover;
        background-position: center;
        background-attachment: fixed; /* Hiệu ứng Parallax nhẹ như Index */
        padding: 140px 0 100px; /* Padding tiêu chuẩn đã chốt */
        color: white;
        position: relative;
        overflow: hidden;
    }

        /* Đốm sáng xanh đặc trưng */
        .service-hero::after {
            content: "";
            position: absolute;
            top: -10%;
            right: -5%;
            width: 500px;
            height: 500px;
            background: rgba(38, 198, 218, 0.15);
            filter: blur(120px);
            border-radius: 50%;
            z-index: 1;
        }

        .service-hero .container {
            position: relative;
            z-index: 2;
        }

    /* Tiêu đề display-title đồng bộ */
    .display-title {
        font-size: calc(1.3rem + 1.8vw);
        font-weight: 700 !important;
        line-height: 1.2;
    }

    .service-hero p.lead {
        font-size: 1.05rem; 
        max-width: 750px;
        opacity: 0.85;
    }

    /* 3. NỘI DUNG VÀ TIỆN ÍCH */
    .py-100 {
        padding: 100px 0;
    }

    .bg-soft {
        background-color: #f4fbfb;
    }

    .text-teal {
        color: #00796b;
    }

    /* Service Cards nâng cấp nhẹ */
    .service-card {
        border: 1px solid #eee;
        border-radius: 24px;
        padding: 40px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        height: 100%;
        background: #ffffff;
    }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,121,107,0.1);
            border-color: #26c6da;
        }

    .icon-box {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin-bottom: 25px;
        background: rgba(38, 198, 218, 0.1);
        color: #26c6da;
    }

    .process-dot {
        width: 12px;
        height: 12px;
        background: #26c6da;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
    }
</style>

<header class="service-hero text-center">
    <div class="container">
        <span class="badge bg-info bg-opacity-25 text-info px-3 py-2 rounded-pill fw-bold mb-3" style="letter-spacing: 1px;">
            Our Ecosystem
        </span>
        <h1 class="display-title mb-4">
            Comprehensive solutions for <br><span style="color: #26c6da;">all types of events</span>
        </h1>
        <p class="lead opacity-75 mx-auto mb-0" style="max-width: 800px;">
            From professional seminars to music festivals with thousands of attendees, Eventus provides a powerful toolkit to help you operate smoothly and efficiently.
        </p>
    </div>
</header>

<section class="py-100">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-teal fw-bold text-uppercase" style="letter-spacing: 2px;">Core services</h6>
            <h2 class="fw-bold display-6">How can we help you?</h2>
            <div class="mx-auto bg-teal mt-3" style="width: 60px; height: 4px; border-radius: 2px;"></div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="service-card shadow-sm">
                    <div class="icon-box">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Ticketing management</h4>
                    <p class="text-muted mb-4 small">Create multiple ticket tiers (early bird, VIP, standard), set up discount codes, and track revenue in real-time.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><i class="bi bi-check2-circle text-teal me-2"></i>Flexible seating charts</li>
                        <li><i class="bi bi-check2-circle text-teal me-2"></i>Multi-channel payments</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="service-card shadow-sm">
                    <div class="icon-box" style="color: #00796b; background: rgba(0, 121, 107, 0.1);">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Smart check-in</h4>
                    <p class="text-muted mb-4 small">QR code scanning technology makes guest welcoming fast, minimizing queues and preventing ticket fraud.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><i class="bi bi-check2-circle text-teal me-2"></i>Mobile scanning app</li>
                        <li><i class="bi bi-check2-circle text-teal me-2"></i>Real-time synchronization</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="service-card shadow-sm">
                    <div class="icon-box" style="color: #6f42c1; background: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-megaphone"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Marketing tools</h4>
                    <p class="text-muted mb-4 small">Send automated schedule reminders, update notifications, and integrate Facebook/Google tracking.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><i class="bi bi-check2-circle text-teal me-2"></i>Email automation</li>
                        <li><i class="bi bi-check2-circle text-teal me-2"></i>Landing page builder</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="service-card shadow-sm">
                    <div class="icon-box" style="color: #fd7e14; background: rgba(253, 126, 20, 0.1);">
                        <i class="bi bi-graph-up"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Reports & analytics</h4>
                    <p class="text-muted mb-0 small">Visual charts on customer behavior, guest acquisition sources, and accurate ticket sales forecasting.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="service-card shadow-sm">
                    <div class="icon-box" style="color: #198754; background: rgba(25, 135, 84, 0.1);">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Financial transparency</h4>
                    <p class="text-muted mb-0 small">Automated reconciliation system, fast withdrawal requests, and tax/fee management for every transaction.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="service-card shadow-sm">
                    <div class="icon-box" style="color: #dc3545; background: rgba(220, 53, 69, 0.1);">
                        <i class="bi bi-person-gear"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Operational support</h4>
                    <p class="text-muted mb-0 small">Technical team available 24/7 to handle incidents and consult on professional event operation processes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-100 bg-soft">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <h2 class="fw-bold display-6 mb-4">Implementation process</h2>
                <p class="text-muted mb-5">We accompany you from the idea stage until the last guests leave.</p>

                <div class="d-flex mb-4">
                    <div class="me-3"><span class="process-dot"></span></div>
                    <div>
                        <h6 class="fw-bold mb-1">Step 1: Event initialization</h6>
                        <p class="small text-muted mb-0">Register information, set up ticket tiers and your landing page.</p>
                    </div>
                </div>
                <div class="d-flex mb-4">
                    <div class="me-3"><span class="process-dot"></span></div>
                    <div>
                        <h6 class="fw-bold mb-1">Step 2: Promotion & sales</h6>
                        <p class="small text-muted mb-0">Activate marketing campaigns and collect ticket payments automatically.</p>
                    </div>
                </div>
                <div class="d-flex">
                    <div class="me-3"><span class="process-dot"></span></div>
                    <div>
                        <h6 class="fw-bold mb-1">Step 3: Operation & reporting</h6>
                        <p class="small text-muted mb-0">On-site check-in and receive detailed post-event reports.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="rounded-4 overflow-hidden shadow-lg border border-5 border-white">
                    <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=800&q=80" alt="Process" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-100">
    <div class="container text-center">
        <h2 class="fw-bold display-6 mb-5">Frequently asked questions</h2>
        <div class="row justify-content-center text-start">
            <div class="col-lg-8">
                <div class="accordion accordion-flush shadow-sm border rounded-4 overflow-hidden" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#q1">
                                How much does it cost to use the platform?
                            </button>
                        </h2>
                        <div id="q1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted small">
                                We provide a "pay as you go" model, where you only pay fees based on each ticket sold. For free events, you can use Eventus completely free of charge.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#q2">
                                Does the system support ticket refunds?
                            </button>
                        </h2>
                        <div id="q2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted small">
                                Yes, administrators have the right to approve ticket refunds directly on the dashboard, and funds will be returned to the customer's account according to regulations.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5 container">
    <div class="p-5 rounded-5 text-center text-white shadow-lg"
         style="background: linear-gradient(135deg, #004d40 0%, #00796b 100%);">
        <h2 class="fw-bold mb-3">Ready to elevate your event?</h2>
        <p class="mb-4 opacity-75 lead">Join hundreds of other professional organizers.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/Organizer/Account/Register" class="btn btn-info btn-lg px-4 rounded-pill fw-bold text-white shadow-sm">Start now</a>
            <a href="/Organizer/Home/Contact" class="btn btn-outline-light btn-lg px-4 rounded-pill fw-bold">Get a quote</a>
        </div>
    </div>
</section>