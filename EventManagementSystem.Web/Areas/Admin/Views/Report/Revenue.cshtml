@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4" style="background-color: #f8fafc;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Reports & Analytics</h2>
            <p class="text-muted">Comprehensive platform performance reports</p>
        </div>
        <button class="btn btn-outline-dark rounded-pill px-4 shadow-sm bg-white">
            <i class="bi bi-upload me-2"></i> Export Report
        </button>
    </div>
@* --- PHẦN LỌC THỜI GIAN MỚI THÊM --- *@
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <form method="get" asp-action="Revenue" class="row align-items-center g-3">
            <div class="col-md-auto">
                <span class="text-muted small fw-bold text-uppercase"><i class="bi bi-filter me-1"></i> Time Range:</span>
            </div>
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-range"></i></span>
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control border-start-0 ps-0" placeholder="From Date">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-check"></i></span>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control border-start-0 ps-0" placeholder="To Date">
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">
                    Apply Filter
                </button>
                <a asp-action="Revenue" class="btn btn-light btn-sm rounded-pill px-3 ms-2 text-muted">Reset</a>
            </div>
        </form>
    </div>
    @* ---------------------------------- *@    @* 4 Stats Cards với dữ liệu thực tế *@
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">Total Revenue (YTD)</small>
                        <h3 class="fw-bold mb-1">@ViewBag.TotalRevenue.ToString("N0") đ</h3>
                        @* <span class="text-success small fw-bold"><i class="bi bi-graph-up"></i> +18.2%</span> *@
                    </div>
                    <div class="bg-success bg-opacity-10 p-2 rounded-3 text-success"><i class="bi bi-currency-dollar fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">Total Tickets Sold</small>
                        <h3 class="fw-bold mb-1">@ViewBag.TicketsSold.ToString("N0")</h3>
                        @* <span class="text-success small fw-bold"><i class="bi bi-people"></i> +12.8%</span> *@
                    </div>
                    <div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary"><i class="bi bi-ticket-perforated fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">Total Events</small>
                        <h3 class="fw-bold mb-1">@ViewBag.TotalEvents</h3>
                        @* <span class="text-success small fw-bold"><i class="bi bi-calendar-check"></i> +15.3%</span> *@
                    </div>
                    <div class="bg-info bg-opacity-10 p-2 rounded-3 text-info"><i class="bi bi-calendar-event fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">Avg Revenue/Event</small>
                        <h3 class="fw-bold mb-1">@ViewBag.AvgRevenue.ToString("N0") đ</h3>
                        @* <span class="text-success small fw-bold">↑ 2.4%</span> *@
                    </div>
                    <div class="bg-warning bg-opacity-10 p-2 rounded-3 text-warning"><i class="bi bi-bar-chart fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        @* Biểu đồ xu hướng doanh thu *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-4">Revenue Trend </h5>
                <div style="height: 350px;">
                    <canvas id="revenueTrendChart"></canvas>
                </div>
            </div>
        </div>

        @* Top Performing Organizers *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-4">Top Performing Organizers</h5>
                @foreach (var org in Model) {
                    <div class="d-flex align-items-center mb-4">
                        <div class="p-2 bg-light rounded-circle me-3 border" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                            <span class="fw-bold text-primary">@org.Name.Substring(0, 1)</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold text-dark">@org.Name</h6>
                            <small class="text-muted">@org.Count events</small>
                        </div>
                        <div class="fw-bold text-dark">@org.Revenue.ToString("N0") đ</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueTrendChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(13, 110, 253, 0.2)');
        gradient.addColorStop(1, 'rgba(13, 110, 253, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Revenue ($)',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartData)),
                    borderColor: '#0d6efd',
                    borderWidth: 3,
                    fill: true,
                    backgroundColor: gradient,
                    tension: 0.4,
                    pointRadius: 5,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#0d6efd',
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { 
                    y: { beginAtZero: true, grid: { borderDash: [5, 5], drawBorder: false } }, 
                    x: { grid: { display: false } } 
                }
            }
        });
    </script>
}