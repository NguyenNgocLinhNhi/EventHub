@using EventManagementSystem.Web.Areas.Admin.ViewModels
@model IEnumerable<EventManagementViewModel>
@{
    ViewData["Title"] = "Events Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var stats = ViewBag.Stats;
}

<style>
 /* Tùy chỉnh Card theo phong cách mới */
.card-custom {
    border: none;
    border-radius: 12px;
    background-color: #ffffff;
    transition: all 0.3s ease;
    position: relative;
}

.card-custom:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
}

/* Vòng tròn chứa biểu tượng */
.icon-shape {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
}

/* Các biến thể màu sắc cho vòng tròn */
.bg-soft-blue { background-color: #e0f2fe; color: #0ea5e9; }
.bg-soft-green { background-color: #dcfce7; color: #16a34a; }
.bg-soft-orange { background-color: #ffedd5; color: #f97316; }

/* Chỉ số phần trăm (Badge) góc trên bên phải */
.stat-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    background-color: #f1f5f9;
    color: #16a34a;
}
</style>

<div class="container-fluid p-4" style="background-color: #f8fafc; font-family: 'Inter', sans-serif;">
    <div class="mb-4">
        <h2 class="fw-bold text-dark">Events Management</h2>
        <p class="text-muted small">Monitor all events across the platform</p>
    </div>

    @* Statistics Cards Section *@
   @* Statistics Cards Section *@
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card card-custom shadow-sm p-3">
            <span class="stat-badge">+5%</span>
            <div class="icon-shape bg-soft-blue">
                <i class="bi bi-calendar-event-fill fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-0 fw-bold">Total Events</p>
                <h3 class="fw-bold mb-0 text-dark">@stats.Total</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom shadow-sm p-3">
            <span class="stat-badge">+2%</span>
            <div class="icon-shape bg-soft-blue">
                <i class="bi bi-briefcase-fill fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-0 fw-bold">Upcoming</p>
                <h3 class="fw-bold mb-0 text-dark">@stats.Upcoming</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom shadow-sm p-3">
            <span class="stat-badge">+8%</span>
            <div class="icon-shape bg-soft-green">
                <i class="bi bi-play-circle-fill fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-0 fw-bold">Ongoing</p>
                <h3 class="fw-bold mb-0 text-dark">@stats.Ongoing</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom shadow-sm p-3">
            <div class="icon-shape bg-soft-green">
                <i class="bi bi-ticket-perforated-fill fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-0 fw-bold">Total Revenue</p>
                <h3 class="fw-bold mb-0 text-dark">@string.Format("{0:N0}", stats.Revenue) đ</h3>
            </div>
        </div>
    </div>
</div>

    @* Search & Filter Bar *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                        <input type="text" id="eventSearchInput" class="form-control border-0 shadow-none" 
                               placeholder="Search events by title or organizer...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="statusFilterSelect" class="form-select border-0 shadow-none bg-light rounded-pill px-3">
                        <option value="">All Statuses</option>
                        <option value="Upcoming">Approved (Upcoming)</option>
                        <option value="Ongoing">Ongoing</option>
                        <option value="Completed">Completed</option>
                        <option value="Pending">Pending Approval</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <div class="col-md-2 text-end border-start">
                    <a asp-action="ExportToExcel" class="btn btn-success border-0 rounded-pill px-3 shadow-sm w-100">
                        <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* Event Table *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="eventDataTable">
                <thead class="bg-light text-muted small text-uppercase fw-bold">
                    <tr>
                        <th class="ps-4 py-3">Event</th>
                        <th>Organizer</th>
                        <th>Date & Location</th>
                        <th>Tickets Sold</th>
                        <th>Revenue</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="eventTableBody">
                    @foreach(var item in Model) {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="p-2 bg-primary bg-opacity-10 rounded me-3 text-primary"><i class="bi bi-calendar3"></i></div>
                                <span class="fw-bold text-dark event-title">@item.Title</span>
                            </div>
                        </td>
                        <td><span class="text-muted small organizer-name">@item.OrganizerName</span></td>
                        <td>
                            <div class="small fw-bold">@item.StartDate.ToString("MM/dd/yyyy")</div>
                            <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@item.Location</div>
                        </td>
                        <td>
                            <div class="small fw-bold">@item.TicketsSold / @item.TotalTickets</div>
                            <div class="progress mt-1" style="height: 4px; width: 80px;">
                                @{
                                    var percent = item.TotalTickets > 0 ? (item.TicketsSold * 100 / item.TotalTickets) : 0;
                                }
                                <div class="progress-bar bg-primary" style="width: @percent%"></div>
                            </div>
                        </td>
                        <td class="fw-bold text-dark">@item.Revenue.ToString("N0") đ</td>
                        <td>
                            <span class="badge rounded-pill status-text @(item.Status == "Upcoming" ? "bg-primary-subtle text-primary" : (item.Status == "Ongoing" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")) px-3">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light rounded-circle shadow-sm">
                                <i class="bi bi-eye text-primary"></i>
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Logic lọc dữ liệu thực tế ngay tại trình duyệt
            function filterEvents() {
                const searchTerm = $("#eventSearchInput").val().toLowerCase();
                const statusFilter = $("#statusFilterSelect").val().toLowerCase();

                $("#eventTableBody tr").each(function () {
                    const title = $(this).find(".event-title").text().toLowerCase();
                    const organizer = $(this).find(".organizer-name").text().toLowerCase();
                    const status = $(this).find(".status-text").text().trim().toLowerCase();

                    const matchSearch = title.includes(searchTerm) || organizer.includes(searchTerm);
                    const matchStatus = statusFilter === "" || status.includes(statusFilter);

                    if (matchSearch && matchStatus) {
                        $(this).fadeIn(200);
                    } else {
                        $(this).hide();
                    }
                });
            }

            $("#eventSearchInput").on("keyup", filterEvents);
            $("#statusFilterSelect").on("change", filterEvents);
        });

        function clearFilters() {
            $("#eventSearchInput").val("");
            $("#statusFilterSelect").val("");
            $("#eventTableBody tr").fadeIn(200);
        }
    </script>
}