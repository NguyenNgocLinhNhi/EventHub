@model EventManagementSystem.Web.Models.Entities.Event
@{
    ViewData["Title"] = "Event Details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4" style="background-color: #f8fafc; min-height: 100vh;">
    @* Header: Quay lại và Trạng thái *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 mb-2">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <h2 class="fw-bold text-dark">@Model.Title</h2>
            <span class="badge rounded-pill @(Model.Status == "Upcoming" ? "bg-primary" : "bg-success") px-3">
                @Model.Status
            </span>
        </div>
        <div class="btn-group gap-2">
            @if (Model.Status == "Pending")
            {
                <button onclick="approveEvent(@Model.Id)" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Approve Event
                </button>
            }
           @*  <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a> *@
        </div>
    </div>

    <div class="row g-4">
        @* Cột trái: Thông tin chi tiết *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">General Information</h5>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Location</div>
                        <div class="col-sm-8 fw-bold">@Model.Location</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Start Date</div>
                        <div class="col-sm-8 fw-bold">@Model.StartDate.ToString("MMMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Category</div>
                        <div class="col-sm-8"><span class="badge bg-light text-dark border">@Model.Category?.Name</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Description</div>
                        <div class="col-sm-8">@Html.Raw(Model.Description)</div>
                    </div>
                </div>
            </div>

            @* Danh sách loại vé và tồn kho *@
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">Ticket Tiers & Inventory</h5>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Ticket Type</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.TicketTypes)
                                {
                                    <tr>
                                        <td class="fw-bold">@ticket.Name</td>
                                        <td>$@ticket.Price.ToString("N0")</td>
                                        <td>@ticket.Quantity</td>
                                        <td>
                                            <span class="badge @(ticket.Quantity > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                @(ticket.Quantity > 0 ? "In Stock" : "Sold Out")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* Cột phải: Nhà tổ chức & Thống kê nhanh *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Organizer</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-building text-primary fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold">@Model.Organizer?.OrganizationName</div>
                            <small class="text-muted">Contact: @Model.Organizer?.Email</small>
                        </div>
                    </div>
                </div>
            </div>

          
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function approveEvent(id) {
            Swal.fire({
                title: 'Approve this event?',
                text: "The event will be published to the platform.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                confirmButtonText: 'Yes, Approve'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Admin/Event/ApproveEvent/' + id, function() {
                        Swal.fire('Approved!', 'Event has been published.', 'success')
                        .then(() => location.reload());
                    });
                }
            });
        }
    </script>
}