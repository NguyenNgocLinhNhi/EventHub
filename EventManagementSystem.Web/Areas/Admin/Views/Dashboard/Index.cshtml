@model EventManagementSystem.Web.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin management system - Eventus";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@* Đảm bảo font Arimo được áp dụng cho toàn bộ nội dung view *@
<div class="container-fluid p-4 bg-light" style="font-family: 'Arimo', sans-serif;">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-bold mb-0">Admin dashboard</h2>
            <p class="text-muted">Overview of the entire system operations.</p>
        </div>
        <div class="d-flex gap-3 bg-white p-2 rounded-3 shadow-sm border border-light">
            <div class="px-3 text-center border-end">
                <small class="text-muted d-block small fw-bold text-uppercase">Platform visits</small>
                <span class="fw-bold text-primary fs-5">@Model.TotalSystemViews.ToString("N0")</span>
            </div>
            <div class="px-3 text-center">
                <small class="text-muted d-block small fw-bold text-uppercase">Service fees (10%)</small>
                <span class="fw-bold text-success fs-5">@Model.TotalCommission.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    <div class="row mb-4 g-3">
        @{
            var stats = new[] {
                new { Title = "Total users", Value = Model.TotalUsers.ToString("N0"), Color = "primary", Icon = "bi-people", Growth = "+5%" },
                new { Title = "Organizers", Value = Model.TotalOrganizers.ToString("N0"), Color = "info", Icon = "bi-briefcase", Growth = "+2%" },
                new { Title = "Active events", Value = Model.TotalActiveEvents.ToString("N0"), Color = "warning", Icon = "bi-calendar-check", Growth = "+8%" },
                new { Title = "Issued tickets", Value = Model.TotalTicketsSold.ToString("N0"), Color = "success", Icon = "bi-ticket-perforated", Growth = "+15%" }
                };
        }

        @foreach (var stat in stats)
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 stat-card h-100 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle bg-@stat.Color bg-opacity-10 p-3">
                            <i class="bi @stat.Icon text-@stat.Color fs-4"></i>
                        </div>
                        <span class="badge bg-light text-success rounded-pill px-2 py-1 small">@stat.Growth</span>
                    </div>
                    <h6 class="text-muted mb-1 small fw-bold">@stat.Title</h6>
                    <h3 class="fw-bold mb-0">@stat.Value</h3>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-bold mb-0">Recently updated events</h5>
                    <a href="#" class="btn btn-sm btn-light rounded-pill px-3 border">View all</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 small text-muted text-uppercase">Event</th>
                                <th class="small text-muted text-uppercase">Organizer</th>
                                <th class="small text-muted text-uppercase">Status</th>
                                <th class="small text-muted text-uppercase">Created date</th>
                                <th class="text-end pe-4 small text-muted text-uppercase">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model.RecentEvents)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                                                <i class="bi bi-calendar-event text-primary"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@ev.Title</span>
                                        </div>
                                    </td>
                                    <td><span class="text-muted">@ev.OrganizerName</span></td>
                                    <td>
                                        <span class="badge rounded-pill @(ev.IsApproved ? "bg-success-light text-success" : "bg-warning-light text-warning")"
                                              style="font-size: 0.75rem; @(ev.IsApproved ? "background-color:#e8f5e9; color:#2e7d32;" : "background-color:#fff3e0; color:#ef6c00;")">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>
                                            @(ev.IsApproved ? "Active" : "Paused")
                                        </span>
                                    </td>
                                    <td class="text-muted small">@ev.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary rounded-circle shadow-sm">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold mb-4">Recent fee transactions</h5>
                <div class="d-flex flex-column gap-4">
                    @foreach (var log in Model.RecentTransactions)
                    {
                        <div class="d-flex align-items-center hover-shadow transition p-2 rounded-3">
                            <div class="bg-success bg-opacity-10 p-2 rounded-circle me-3">
                                <i class="bi bi-arrow-up-right text-success fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small text-dark text-truncate" style="max-width: 150px;">@log.UserEmail</span>
                                    <span class="text-success small fw-bold">+@log.Amount.ToString("N0")đ</span>
                                </div>
                                <small class="text-muted d-block text-truncate" style="max-width: 200px;">Event: @log.EventTitle</small>
                            </div>
                        </div>
                    }
                </div>
                <button class="btn btn-primary w-100 rounded-pill mt-auto py-2 shadow-sm">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>View detailed report
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
    }

        .stat-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .bg-success-light {
        background-color: #e8f5e9;
    }

    .bg-warning-light {
        background-color: #fff3e0;
    }

    .hover-shadow:hover {
        background-color: #f8f9fa;
        cursor: pointer;
    }

    .transition {
        transition: all 0.2s ease-in-out;
    }

    .table thead th {
        border-top: none;
    }
</style>