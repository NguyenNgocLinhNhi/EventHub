@model IEnumerable<EventManagementSystem.Web.Areas.Admin.ViewModels.TemplateManagementViewModel>
@{
    ViewData["Title"] = "Template management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* Absolute z-index fix */
    .modal {
        z-index: 1060 !important;
    }

    .modal-backdrop {
        z-index: 1050 !important;
    }

    .template-card {
        transition: all 0.3s ease;
        border: 1px solid #eee !important;
        background: #fff;
    }

    .template-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(13, 110, 253, 0.1) !important;
    }

    /* Hiệu ứng Overlay khi hover vào ảnh để hiện nút Demo */
    .preview-wrapper {
        position: relative;
        overflow: hidden;
    }

    .template-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .preview-wrapper:hover .template-overlay {
        opacity: 1;
    }

    .text-blue {
        color: #0d6efd;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 40px;
    }

    /* Đảm bảo iframe chiếm toàn bộ không gian Modal */
    .demo-iframe-container {
        position: relative;
        width: 100%;
        height: 75vh;
        background: #fff;
    }
    
    .demo-iframe {
        width: 100%;
        height: 100%;
        border: none;
    }
</style>

<div class="container-fluid p-4" style="font-family: 'Arimo', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Interface Template gallery</h2>
            <p class="text-muted small">Manage and update Landing Page samples for the system.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-2"></i> Add New Template
        </a>
    </div>

    @* Search & Filter bar *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="input-group border rounded-3 overflow-hidden">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="templateSearch" class="form-control border-0 shadow-none" placeholder="Search template name...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select border-0 bg-white shadow-none">
                        <option value="">All statuses</option>
                        <option value="Available">Active</option>
                        <option value="Hidden">Locked</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @* Template list *@
    <div class="row g-4" id="templateGrid">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-3 template-item" data-name="@item.Name.ToLower()" data-status="@(item.IsActive ? "Available" : "Hidden")">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden template-card">
                    <div class="preview-wrapper">
                        <img src="@(string.IsNullOrEmpty(item.PreviewImageUrl) ? "/images/default-template.png" : item.PreviewImageUrl)"
                             class="card-img-top" style="height: 180px; object-fit: cover;" alt="@item.Name">
                        
                        @* Nút View Demo hiện lên khi hover *@
                        <div class="template-overlay">
                            <button type="button" class="btn btn-light rounded-pill px-4 fw-bold btn-preview-template" 
                                    data-url="@Url.Content("~/Templates/" + item.Id + "/index.html")"
                                    data-name="@item.Name">
                                <i class="bi bi-play-circle-fill me-1"></i> View Demo
                            </button>
                        </div>

                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge rounded-pill @(item.IsActive ? "bg-success" : "bg-danger") shadow-sm">
                                @(item.IsActive ? "Available" : "Hidden")
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold text-dark mb-0">@item.Name</h6>
                            <small class="text-primary fw-bold" style="font-size: 10px;">ID: @item.Id</small>
                        </div>
                        <p class="text-muted small text-truncate-2 mb-3">@item.Description</p>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <div>
                                <small class="text-muted d-block small" style="font-size:10px; font-weight: 700;">USAGE</small>
                                <span class="fw-bold text-blue">@item.UsageCount times</span>
                            </div>
                            <div class="btn-group gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-light border rounded-circle shadow-sm btn-toggle-template"
                                        data-id="@item.Id"
                                        title="@(item.IsActive ? "Lock Template" : "Unlock Template")">
                                    <i id="lock-icon-@item.Id" class="bi @(item.IsActive ? "bi-unlock-fill text-success" : "bi-lock-fill text-danger")"></i>
                                </button>
                                
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light border rounded-circle shadow-sm" title="Edit information">
                                    <i class="bi bi-pencil-square text-primary"></i>
                                </a>

                                <a asp-action="Usage" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-light border rounded-circle shadow-sm" title="View usage list">
                                    <i class="bi bi-eye-fill text-info"></i>
                                </a>

                                <button type="button" class="btn btn-sm btn-light border rounded-circle shadow-sm"
                                        onclick="confirmDelete('@item.Id')" title="Delete">
                                    <i class="bi bi-trash-fill text-danger"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* --- MODAL XEM TRỰC TIẾP DEMO --- *@
<div class="modal fade" id="demoPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 bg-light">
                <h5 class="fw-bold mb-0" id="demoTemplateTitle">Template Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="demo-iframe-container">
                    <iframe id="demoIframe" src="" class="demo-iframe"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- USAGE DETAILS MODAL --- *@
<div class="modal fade" id="usageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 bg-light">
                <h5 class="fw-bold mb-0">Template usage information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="usageModalBody">
                @* Data will be loaded here via AJAX *@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 1. Logic mở Live Preview
            $(".btn-preview-template").on("click", function () {
                var url = $(this).data("url");
                var name = $(this).data("name");
                
                $("#demoTemplateTitle").text("Live Preview: " + name);
                $("#demoIframe").attr("src", url);
                $("#demoPreviewModal").modal("show");
            });

            // Xóa src của iframe khi đóng modal để giải phóng bộ nhớ và dừng các script của template
            $('#demoPreviewModal').on('hidden.bs.modal', function () {
                $("#demoIframe").attr("src", "");
            });

            // 2. Search and Status Filter logic
            $("#templateSearch, #statusFilter").on("keyup change", function () {
                var searchText = $("#templateSearch").val().toLowerCase();
                var statusSelected = $("#statusFilter").val();

                $(".template-item").each(function () {
                    var templateName = $(this).data("name");
                    var templateStatus = $(this).data("status");

                    var isMatchSearch = templateName.includes(searchText);
                    var isMatchStatus = statusSelected === "" || templateStatus === statusSelected;

                    if (isMatchSearch && isMatchStatus) {
                        $(this).fadeIn(300);
                    } else {
                        $(this).hide();
                    }
                });
            });
        });

        // 3. Handle DELETE Template
        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this interface template?")) {
                $.post("/Admin/TemplateManager/Delete/" + id, function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }).fail(function() {
                    alert("An error occurred while connecting to the server.");
                });
            }
        }

        $(document).on("click", ".btn-toggle-template", function () {
            const id = $(this).data("id");
            const icon = $(`#lock-icon-${id}`);
            const button = $(this);

            if (confirm("Confirm changing the visibility status of this template?")) {
                $.post("/Admin/TemplateManager/ToggleStatus/" + id, function (res) {
                    if (res.success) {
                        if (res.isActive) {
                            icon.removeClass("bi-lock-fill text-danger").addClass("bi-unlock-fill text-success");
                            button.attr("title", "Lock Template");
                            location.reload();
                        } else {
                            icon.removeClass("bi-unlock-fill text-success").addClass("bi-lock-fill text-danger");
                            button.attr("title", "Unlock Template");
                            location.reload();
                        }
                    } else {
                        alert(res.message);
                    }
                });
            }
        });
    </script>
}