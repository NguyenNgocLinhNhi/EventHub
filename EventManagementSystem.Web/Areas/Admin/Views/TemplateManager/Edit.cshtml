@model EventManagementSystem.Web.Models.Entities.LandingPageTemplate
@{
    ViewData["Title"] = "Edit Template";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4" style="font-family: 'Arimo', sans-serif;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small fw-bold text-primary">
            <i class="bi bi-arrow-left me-1"></i> Back to Template gallery
        </a>
        <h2 class="fw-bold mt-2 text-dark">Update Template: @Model.Name</h2>
        <p class="text-muted small">Change description, image, and visibility status of the interface template.</p>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="PreviewImageUrl" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Name" class="form-label small fw-bold text-uppercase">Interface Template Name</label>
                                <input asp-for="Name" class="form-control rounded-3 shadow-none" placeholder="Ex: Charitize (Charity)..." required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-uppercase">Upload Preview Image</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-upload"></i></span>
                                    <input type="file" name="imageFile" id="imageInput" class="form-control border-start-0 rounded-end-3 shadow-none" accept="image/*" />
                                </div>
                                <small class="text-muted mt-1 d-block">Select image from computer folder (.jpg, .png, .webp format).</small>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label small fw-bold text-uppercase">Detailed Description</label>
                                <textarea asp-for="Description" class="form-control rounded-3 shadow-none" rows="4" placeholder="Describe key features of this template..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 py-2">
                                <div class="form-check form-switch p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                    <div class="ms-1">
                                        <label class="form-check-label fw-bold d-block mb-0" for="statusSwitch" style="cursor: pointer;">
                                            Availability Status
                                        </label>
                                        <small class="text-muted fw-normal">Allow Organizers to see and use this template when creating events.</small>
                                    </div>
                                    <input class="form-check-input ms-0" type="checkbox" asp-for="IsActive" id="statusSwitch" style="width: 50px; height: 25px; cursor: pointer;">
                                </div>
                            </div>

                            <div class="col-md-12 text-end mt-4">
                                <hr class="text-muted opacity-25" />
                                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm py-2 mt-2">
                                    <i class="bi bi-save me-2"></i> Save changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-sticky" style="top: 20px;">
                <div class="bg-light p-3 border-bottom">
                    <h6 class="fw-bold mb-0 small text-uppercase"><i class="bi bi-eye me-2"></i>Preview Image</h6>
                </div>
                <div class="card-body p-3 text-center bg-white">
                    <img id="previewImg" src="@(string.IsNullOrEmpty(Model.PreviewImageUrl) ? "/images/default-template.png" : Model.PreviewImageUrl)"
                         class="img-fluid rounded-3 shadow-sm border"
                         style="max-height: 400px; width: 100%; object-fit: cover;"
                         onerror="this.src='/images/default-template.png';" />
                    <div class="mt-3">
                        <span class="badge rounded-pill bg-light text-dark border">
                            Template ID: #@Model.Id
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $("#imageInput").on("change", function () {
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $("#previewImg").attr("src", e.target.result);
                    }
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}