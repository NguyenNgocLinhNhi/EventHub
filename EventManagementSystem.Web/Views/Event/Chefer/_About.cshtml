@model EventManagementSystem.Web.Models.Entities.Event

<style>
    /* Đồng bộ font: Oswald cho tiêu đề và Open Sans cho văn bản */
    #about h1, #about h4, #about .section-title {
        font-family: 'Oswald', sans-serif;
        text-transform: uppercase;
    }

    #about p {
        font-family: 'Open Sans', sans-serif;
    }

    .section-title {
        letter-spacing: 2px;
        font-weight: 700;
    }
</style>

<div class="container-fluid p-5" id="about">
    <div class="row gx-5">
        <div class="col-lg-5 mb-5 mb-lg-0 wow fadeIn" data-wow-delay="0.1s" style="min-height: 500px;">
            <div class="position-relative h-100">
                <img class="position-absolute w-100 h-100 rounded-circle rounded-bottom rounded-end"
                     src="~/Templates/Chefer/img/about.jpg" style="object-fit: cover;" alt="About Image">
            </div>
        </div>
        <div class="col-lg-7">
            <div class="mb-4 wow fadeIn" data-wow-delay="0.2s">
                @* Dịch sang tiếng Anh: About Event / Culinary Excellence *@
                <h5 class="section-title text-primary">About the Event</h5>
                <h1 class="display-3 mb-0">Experience Culinary Excellence</h1>
            </div>
            <p class="mb-4">@Model.Description</p>

            <div class="row">
                <div class="col-sm-6">
                    <div class="bg-light rounded p-4">
                        @* Dịch sang tiếng Anh: Event Schedule *@
                        <h4 class="mb-3">Event Schedule</h4>

                        @* Định dạng lại ngày tháng theo chuẩn tiếng Anh: MMM dd, yyyy *@
                        <p class="mb-1 text-dark">
                            <strong>Starts:</strong> @($"{Model.StartDate:MMM dd, yyyy HH:mm}")
                        </p>
                        @if (Model.EndDate.HasValue)
                        {
                            <p class="mb-0 text-dark">
                                <strong>Ends:</strong> @($"{Model.EndDate.Value:MMM dd, yyyy HH:mm}")
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>