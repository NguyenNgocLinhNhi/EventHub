@model IEnumerable<EventManagementSystem.Web.Models.Entities.TicketType>

<style>
    /* Đồng bộ font: Oswald cho tiêu đề và Open Sans cho văn bản nội dung */
    #tickets h1,
    #tickets h3,
    #tickets h5,
    #tickets .section-title {
        font-family: 'Oswald', sans-serif;
        text-transform: uppercase;
    }

    #tickets p,
    #tickets a {
        font-family: 'Open Sans', sans-serif;
    }

    /* Hiệu ứng hover cho card vé tương đồng với các mục khác */
    .ticket-card {
        transition: .3s;
        border: 1px solid #333;
    }

        .ticket-card:hover {
            border-color: #D4A762;
            transform: translateY(-5px);
        }
</style>

<div class="container-fluid menu py-5 px-0" id="tickets">
    @* Tiêu đề chính dịch sang tiếng Anh: Ticket Pricing / Choose Your Experience *@
    <div class="mb-5 text-center" style="max-width: 700px; margin: auto;">
        <h5 class="section-title text-primary">Ticket Pricing</h5>
        <h1 class="display-3 mb-0">Choose Your Culinary Experience</h1>
    </div>

    <div class="container">
        <div class="row g-4 justify-content-center">
            @foreach (var ticket in Model)
            {
                <div class="col-lg-4">
                    <div class="bg-dark text-center p-5 rounded ticket-card">
                        <h3 class="text-primary mb-4">@ticket.Name</h3>

                        @* Hiển thị giá vé kèm đơn vị VNĐ *@
                        <h1 class="display-4 text-white mb-4">@ticket.Price.ToString("N0") VNĐ</h1>

                        @* Dịch: Số lượng còn lại -> Tickets Left *@
                        <p class="text-secondary mb-4">Tickets Left: @ticket.Quantity</p>

                        @* Nút đặt vé dịch sang tiếng Anh: BOOK NOW *@
                        <a href="@Url.Action("BookingProcess", "Booking", new { id = ticket.EventId })" class="btn btn-primary w-100 py-3">
                            <i class="fa fa-shopping-cart me-2"></i>BOOK NOW
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>