@model IEnumerable<EventManagementSystem.Web.Models.Entities.Schedule>

@if (Model != null && Model.Any())
{
    <style>
        /* Đồng bộ font chữ với các thành phần khác trong Layout */
        #schedule,
        #schedule h3,
        #schedule h5,
        #schedule p {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
        }

        /* Tăng cường độ rõ nét cho các khối lịch trình */
        .schedule-item {
            transition: all 0.3s ease;
            border-left: 5px solid #5864FF !important;
        }

            .schedule-item:hover {
                transform: translateX(10px);
                background-color: #f8f9ff !important;
            }

        .schedule-title {
            color: #2e2e2e;
            font-weight: 700;
        }
    </style>

    <section id="schedule" class="about-section py-5">
        <div class="container">
            <div class="section-title text-center mb-50">
                @* Chuyển đổi tiêu đề sang tiếng Anh *@
                <h3 class="mb-25">Event Schedule</h3>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    @foreach (var item in Model.OrderBy(s => s.StartTime))
                    {
                        <div class="p-4 mb-3 rounded bg-white shadow-sm schedule-item">
                            @* Định dạng thời gian *@
                            <h5 class="text-primary fw-bold">
                                @item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")
                            </h5>

                            <h5 class="mt-2 schedule-title">@item.Title</h5>

                            @* Chuyển đổi nhãn vị trí sang tiếng Anh *@
                            <p class="text-muted small">
                                <i class="lni lni-map-marker"></i>
                                @(string.IsNullOrEmpty(item.Location) ? "Main Hall" : item.Location)
                            </p>

                            <p class="mt-2">@item.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}