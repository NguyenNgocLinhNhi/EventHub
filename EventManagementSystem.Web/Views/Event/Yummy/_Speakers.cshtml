@model IEnumerable<EventManagementSystem.Web.Models.Entities.Speaker>

<section id="speakers" class="chefs section">
    <div class="container section-title" data-aos="fade-up">
        <h2 style="font-family: 'Plus Jakarta Sans', sans-serif;">Our Team</h2>
        <p><span style="font-family: 'Inter', sans-serif;">Professional</span> <span class="description-title" style="font-family: 'Plus Jakarta Sans', sans-serif;">Speakers</span></p>
    </div>

    <div class="container">
        <div class="row gy-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var s in Model)
                {
                    <div class="col-lg-4 d-flex align-items-stretch" data-aos="fade-up">
                        <div class="team-member">
                            <div class="member-img">
                                <img src="@(s.ImageUrl ?? "/Templates/Yummy/assets/img/chefs/chefs-1.jpg")" class="img-fluid" alt="@s.Name">
                                <div class="social">
                                    @if (!string.IsNullOrEmpty(s.SocialUrl))
                                    {
                                        <a href="@s.SocialUrl"><i class="bi bi-facebook"></i></a>
                                    }
                                    <a href="#"><i class="bi bi-linkedin"></i></a>
                                </div>
                            </div>
                            <div class="member-info">
                                <h4 style="font-family: 'Plus Jakarta Sans', sans-serif;">@s.Name</h4>
                                <span style="font-family: 'Inter', sans-serif;">@s.JobTitle</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center" data-aos="fade-up">
                    <p style="font-family: 'Inter', sans-serif;">Speaker information is being updated...</p>
                </div>
            }
        </div>
    </div>
</section>