@model IEnumerable<EventManagementSystem.Web.Models.Entities.Sponsor>

<section id="sponsors" class="gallery section">
    <div class="container section-title" data-aos="fade-up">
        <h2 style="font-family: 'Plus Jakarta Sans', sans-serif;">Partners</h2>
        <p><span style="font-family: 'Inter', sans-serif;">Our Valuable</span> <span class="description-title" style="font-family: 'Plus Jakarta Sans', sans-serif;">Sponsors</span></p>
    </div>

    <div class="container" data-aos="fade-up">
        <div class="row g-4 justify-content-center align-items-center">
            @if (Model != null && Model.Any())
            {
                foreach (var sponsor in Model)
                {
                    <div class="col-lg-2 col-md-4 col-6 text-center">
                        <a href="@(sponsor.WebsiteUrl ?? "#")" target="_blank">
                            <img src="@sponsor.LogoUrl" class="img-fluid grayscale-img" alt="@sponsor.Name" style="max-height: 80px;">
                        </a>
                        @* Cấp bậc đối tác sử dụng font Inter *@
                        <p class="small mt-2 text-muted" style="font-family: 'Inter', sans-serif;">@sponsor.Rank</p>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p style="font-family: 'Inter', sans-serif; color: #666;">Our partners will be announced soon.</p>
                </div>
            }
        </div>
    </div>
</section>

<style>
    /* Đồng bộ hiệu ứng hình ảnh */
    .grayscale-img {
        filter: grayscale(100%);
        transition: 0.3s;
    }

        .grayscale-img:hover {
            filter: grayscale(0%);
            transform: scale(1.1);
        }
</style>