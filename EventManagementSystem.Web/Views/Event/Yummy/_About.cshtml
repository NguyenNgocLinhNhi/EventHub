@model EventManagementSystem.Web.Models.Entities.Event

<section id="about" class="about section">
    <div class="container section-title" data-aos="fade-up">
        <h2 style="font-family: 'Plus Jakarta Sans', sans-serif;">About Us</h2>
        <p><span style="font-family: 'Inter', sans-serif;">Learn More</span> <span class="description-title" style="font-family: 'Plus Jakarta Sans', sans-serif;">About Event</span></p>
    </div>

    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-7" data-aos="fade-up" data-aos-delay="100">
                <img src="/Templates/Yummy/assets/img/about.jpg" class="img-fluid mb-4 rounded shadow" alt="About Event">

                <div class="book-a-table">
                    <h3 style="font-family: 'Plus Jakarta Sans', sans-serif;">Venue</h3>
                    <p style="font-family: 'Inter', sans-serif;">@Model.Location</p>
                </div>
            </div>

            <div class="col-lg-5" data-aos="fade-up" data-aos-delay="250">
                <div class="content ps-0 ps-lg-5">
                    <div class="mb-4" style="font-family: 'Inter', sans-serif;">
                        @Html.Raw(Model.Description ?? "Event details are being updated...")
                    </div>

                    <ul style="font-family: 'Inter', sans-serif;">
                        <li><i class="bi bi-check-circle-fill"></i> <span>Start Time: @Model.StartDate.ToString("HH:mm - MMM dd, yyyy")</span></li>
                        @if (Model.EndDate.HasValue)
                        {
                            <li><i class="bi bi-check-circle-fill"></i> <span>End Time: @Model.EndDate.Value.ToString("HH:mm - MMM dd, yyyy")</span></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>