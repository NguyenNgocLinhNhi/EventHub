@model EventManagementSystem.Web.Models.Entities.Event

<section id="hero" class="hero section light-background">
    <div class="container">
        <div class="row gy-4 justify-content-center justify-content-lg-between">
            <div class="col-lg-5 order-2 order-lg-1 d-flex flex-column justify-content-center">
                @* Tiêu đề chính sử dụng Font Plus Jakarta Sans đã định nghĩa trong Layout *@
                <h1 data-aos="fade-up" style="font-family: 'Plus Jakarta Sans', sans-serif;">Experience The Ultimate<br>Culinary Art</h1>

                <p data-aos="fade-up" data-aos-delay="100" class="fw-bold text-primary" style="font-family: 'Inter', sans-serif;">@Model.Title</p>

                <p data-aos="fade-up" data-aos-delay="150" style="font-family: 'Inter', sans-serif;">@Model.Location | @Model.StartDate.ToString("MMM dd, yyyy")</p>

                <div class="d-flex" data-aos="fade-up" data-aos-delay="200">
                    <a href="#tickets" class="btn-get-started" style="font-family: 'Inter', sans-serif;">Buy Tickets Now</a>
                    
                </div>
            </div>
            <div class="col-lg-5 order-1 order-lg-2 hero-img" data-aos="zoom-out">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/Templates/Yummy/assets/img/hero-img.png" : Model.ImageUrl)" class="img-fluid animated" alt="@Model.Title">
            </div>
        </div>
    </div>
</section>