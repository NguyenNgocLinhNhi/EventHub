@model IEnumerable<EventManagementSystem.Web.Models.Entities.Schedule>

<section id="schedule" class="menu section light-background">
    <div class="container section-title" data-aos="fade-up">
        <h2 style="font-family: 'Plus Jakarta Sans', sans-serif;">Program</h2>
        <p><span style="font-family: 'Inter', sans-serif;">Detailed</span> <span class="description-title" style="font-family: 'Plus Jakarta Sans', sans-serif;">Schedule</span></p>
    </div>

    <div class="container">
        <div class="row gy-5">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model.OrderBy(s => s.StartTime))
                {
                    <div class="col-lg-4 menu-item" data-aos="fade-up">
                        <div class="p-4 border rounded shadow-sm bg-white h-100">
                            @* Thời gian sử dụng font Inter mạnh mẽ *@
                            <h4 class="text-danger fw-bold" style="font-family: 'Inter', sans-serif;">
                                @item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")
                            </h4>

                            @* Tiêu đề mục sử dụng font Plus Jakarta Sans *@
                            <h4 class="mt-2" style="font-family: 'Plus Jakarta Sans', sans-serif;">@item.Title</h4>

                            <p class="ingredients" style="font-family: 'Inter', sans-serif;">
                                <i class="bi bi-geo-alt"></i> @(item.Location ?? "Main Hall")
                            </p>

                            <p class="price mt-2" style="font-size: 1rem; color: #666; font-family: 'Inter', sans-serif;">
                                @item.Description
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center" data-aos="fade-up">
                    <p style="font-family: 'Inter', sans-serif;">The schedule is being updated...</p>
                </div>
            }
        </div>
    </div>
</section>