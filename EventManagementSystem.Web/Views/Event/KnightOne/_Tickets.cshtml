@model IEnumerable<EventManagementSystem.Web.Models.Entities.TicketType>

<style>
    /* Synchronize Poppins font for Tickets section as in Layout and other views */
    #tickets,
    #tickets h2,
    #tickets h3,
    #tickets h4,
    #tickets p,
    #tickets li,
    #tickets .btn {
        font-family: 'Poppins', sans-serif !important;
    }
</style>

<section id="tickets" class="pricing section">
    @* Section Title translated to English *@
    <div class="container section-title" data-aos="fade-up">
        <h2>Ticket Pricing</h2>
        <p>Choose the ticket type that fits you best</p>
    </div>

    <div class="container">
        <div class="row gy-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var ticket in Model)
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="pricing-item">
                            <h3>@ticket.Name</h3>
                            @* Price display - Changed currency label to USD/Generic if needed *@
                            <h4>@ticket.Price.ToString("N0")<span> USD</span></h4>
                            <ul>
                                @* Ticket details translated to English *@
                                <li><i class="bi bi-check"></i> Remaining quantity: @ticket.Quantity</li>
                                <li><i class="bi bi-check"></i> Fast check-in via QR Code</li>
                            </ul>
                            <div class="btn-wrap">
                                @* Booking button translated to English *@
                                <a href="@Url.Action("BookingProcess", "Booking", new { id = ticket.EventId })" class="btn btn-primary w-100 py-3">
                                    <i class="fa fa-shopping-cart me-2"></i>BOOK NOW
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @* Empty state message translated to English *@
                <div class="col-12 text-center text-muted">Tickets are currently not available for sale.</div>
            }
        </div>
    </div>
</section>