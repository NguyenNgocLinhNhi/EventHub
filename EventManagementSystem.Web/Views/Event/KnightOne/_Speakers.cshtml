@model IEnumerable<EventManagementSystem.Web.Models.Entities.Speaker>

<style>
    /* Đồng bộ font chữ Poppins cho phần Speakers tương tự như các View khác */
    #speakers, #speakers h2, #speakers h4, #speakers p, #speakers span {
        font-family: 'Poppins', sans-serif !important;
    }
</style>

<section id="speakers" class="team section">
    @* Tiêu đề section chuyển sang tiếng Anh *@
    <div class="container section-title" data-aos="fade-up">
        <h2>Speakers</h2>
        <p>Meet the experts joining our event</p>
    </div>

    <div class="container">
        <div class="row gy-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var s in Model)
                {
                    <div class="col-lg-3 col-md-6 d-flex align-items-stretch" data-aos="fade-up">
                        <div class="team-member">
                            <div class="member-img">
                                <img src="@(s.ImageUrl ?? "/Templates/Knightone/assets/img/team/team-1.jpg")" class="img-fluid" alt="@s.Name">
                                <div class="social">
                                    @if (!string.IsNullOrEmpty(s.SocialUrl))
                                    {
                                        <a href="@s.SocialUrl" target="_blank"><i class="bi bi-facebook"></i></a>
                                    }
                                    <a href=""><i class="bi bi-twitter-x"></i></a>
                                    <a href=""><i class="bi bi-linkedin"></i></a>
                                </div>
                            </div>
                            <div class="member-info">
                                <h4>@s.Name</h4>
                                <span>@s.JobTitle</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @* Thông báo trống chuyển sang tiếng Anh *@
                <div class="col-12 text-center">
                    <p>Speaker information will be updated soon.</p>
                </div>
            }
        </div>
    </div>
</section>