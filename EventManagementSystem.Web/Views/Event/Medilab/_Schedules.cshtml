@model IEnumerable<EventManagementSystem.Web.Models.Entities.Schedule>

<style>
    /* Synchronize Roboto font for the entire Schedule section */
    #schedule,
    #schedule h2,
    #schedule h3,
    #schedule h4,
    #schedule p,
    #schedule div,
    #schedule small {
        font-family: 'Roboto', sans-serif !important;
    }
</style>

<section id="schedule" class="services section light-background">
    <div class="container section-title" data-aos="fade-up">
        <h2>Detailed Schedule</h2>
        <p>Timeline of discussion sessions and scientific activities</p>
    </div>

    <div class="container">
        <div class="row gy-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model.OrderBy(s => s.StartTime))
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="service-item position-relative">
                            <div class="icon"><i class="fas fa-heartbeat"></i></div>
                            <h3>@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</h3>
                            <h4 class="fw-bold">@item.Title</h4>
                            <p>@item.Description</p>
                            <small class="text-primary"><i class="bi bi-geo-alt"></i> @item.Location</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">The schedule is currently being updated...</div>
            }
        </div>
    </div>
</section>