@model IEnumerable<EventManagementSystem.Web.Models.Entities.Sponsor>

<style>
    /* Synchronize Roboto font for the entire Sponsors section */
    #sponsors,
    #sponsors h2,
    #sponsors p,
    #sponsors div {
        font-family: 'Roboto', sans-serif !important;
    }
</style>

<section id="sponsors" class="gallery section light-background">
    <div class="container section-title" data-aos="fade-up">
        <h2>Our Sponsors</h2>
    </div>
    <div class="container-fluid" data-aos="fade-up">
        <div class="row g-0 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var sponsor in Model)
                {
                    <div class="col-lg-3 col-md-4">
                        <div class="gallery-item text-center p-4">
                            <a href="@(sponsor.WebsiteUrl ?? "#")" target="_blank">
                                <img src="@sponsor.LogoUrl" alt="@sponsor.Name" class="img-fluid"
                                     style="max-height: 80px; filter: grayscale(100%);">
                            </a>
                            <p class="small text-muted mt-2">Rank: @sponsor.Rank</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>