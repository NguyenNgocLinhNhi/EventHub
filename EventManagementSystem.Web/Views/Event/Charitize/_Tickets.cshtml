@model IEnumerable<EventManagementSystem.Web.Models.Entities.TicketType>

<div class="container-fluid py-5" id="tickets">
    <div class="container">
        @* Section title center alignment *@
        <div class="text-center mx-auto wow fadeIn" data-wow-delay="0.1s" style="max-width: 500px;">
            @* .section-title will use Josefin Sans from Layout *@
            <p class="section-title bg-white text-center text-primary px-3">Ticket Packages</p>
            @* .display-6 will use Josefin Sans from Layout *@
            <h1 class="display-6 mb-4">Choose Your Ticket</h1>
        </div>

        <div class="row g-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var ticket in Model)
                {
                    <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.1s">
                        <div class="donation-item d-flex flex-column h-100 p-4 border rounded shadow-sm text-center">
                            <div class="donation-detail w-100">
                                @* Ticket Name - h3 will use Josefin Sans *@
                                <h3 class="mb-3">@ticket.Name</h3>

                                @* Price formatted with VNĐ *@
                                <h2 class="text-primary mb-3">@ticket.Price.ToString("N0") <small class="text-dark" style="font-size: 1rem;">VNĐ</small></h2>

                                <div class="mb-4 text-start d-inline-block">
                                    <p class="mb-1"><i class="fa fa-check text-primary me-2"></i>Quantity: <strong>@ticket.Quantity</strong> tickets</p>
                                    <p class="mb-0"><i class="fa fa-check text-primary me-2"></i>Fast check-in support</p>
                                </div>

                                @* Action button - will use Josefin Sans *@
                                <a href="@Url.Action("BookingProcess", "Booking", new { id = ticket.EventId })" class="btn btn-primary w-100 py-3">
                                    <i class="fa fa-shopping-cart me-2"></i>BOOK NOW
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="alert alert-info">
                        Official ticket information is not yet available. Please check back later!
                    </div>
                </div>
            }
        </div>
    </div>
</div>