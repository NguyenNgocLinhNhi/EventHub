@model IEnumerable<EventManagementSystem.Web.Models.Entities.Speaker>

<style>
    /* Đồng bộ font Roboto cho toàn bộ section Speakers */
    #speakers, #speakers h2, #speakers h4, #speakers p, #speakers span, #speakers div {
        font-family: 'Roboto', sans-serif;
    }
</style>

<section id="speakers" class="doctors section">
    <div class="container section-title" data-aos="fade-up">
        @* Chuyển "Diễn giả & Chuyên gia" -> "Speakers & Experts" *@
        <h2>Speakers & Experts</h2>
        @* Chuyển nội dung mô tả sang tiếng Anh *@
        <p>Leading experts and speakers guiding in-depth discussion sessions at the conference</p>
    </div>
    <div class="container">
        <div class="row gy-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var s in Model)
                {
                    <div class="col-lg-6" data-aos="fade-up">
                        <div class="team-member d-flex align-items-start border p-3 rounded shadow-sm bg-white">
                            <div class="pic">
                                <img src="@(s.ImageUrl ?? "/Templates/Medinova/img/team-1.jpg")"
                                     class="img-fluid rounded-circle"
                                     style="width:150px; height:150px; object-fit:cover;"
                                     alt="@s.Name">
                            </div>
                            <div class="member-info ps-4">
                                <h4>@s.Name</h4>
                                <span class="text-primary fw-bold">@s.JobTitle</span>
                                <div class="social mt-2">
                                    @if (!string.IsNullOrEmpty(s.SocialUrl))
                                    {
                                        <a href="@s.SocialUrl" class="me-2 text-primary"><i class="bi bi-facebook"></i></a>
                                    }
                                    <a href="#" class="text-info"><i class="bi bi-linkedin"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @* Chuyển thông báo cập nhật sang tiếng Anh *@
                <div class="col-12 text-center text-muted">Speaker information is being updated.</div>
            }
        </div>
    </div>
</section>