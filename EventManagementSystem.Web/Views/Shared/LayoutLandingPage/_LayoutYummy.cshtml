@model EventManagementSystem.Web.Models.Entities.Event

@{
    ViewBag.Title = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewBag.Title - Eventus</title>

    <link href="~/Templates/Yummy/assets/img/favicon.png" rel="icon">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <link href="~/Templates/Yummy/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Templates/Yummy/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Templates/Yummy/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/Templates/Yummy/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/Templates/Yummy/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <link href="~/Templates/Yummy/assets/css/main.css" rel="stylesheet">

    <style>
        /* Modern Font Synchronization */
        :root {
            --default-font: "Inter", system-ui, -apple-system, sans-serif;
            --heading-font: "Plus Jakarta Sans", sans-serif;
            --nav-font: "Inter", sans-serif;
        }

        body {
            font-family: var(--default-font);
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .sitename {
            font-family: var(--heading-font);
        }

        /* Integration UI Fixes */
        .btn-home-back {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 9999;
            background: rgba(206, 18, 18, 0.1);
            color: #ce1212;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
            text-decoration: none;
        }

            .btn-home-back:hover {
                background: #ce1212;
                color: white;
            }

        /* Navbar Sitename Limit */
        .header .logo h1 {
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 1.5rem;
            font-weight: 700;
        }
    </style>
</head>

<body class="index-page">

    <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn-home-back" title="Back to Home">
        <i class="bi bi-arrow-left"></i>
    </a>

    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container position-relative d-flex align-items-center justify-content-between">

            <a href="#hero" class="logo d-flex align-items-center me-auto me-xl-0">
                <h1 class="sitename">@Model.Title</h1>
                <span>.</span>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="#hero" class="active">Home</a></li>
                    <li><a href="#about">About</a></li>

                    @if (Model.Schedules != null && Model.Schedules.Any())
                    {
                        <li><a href="#schedule">Schedule</a></li>
                    }

                    @if (Model.Speakers != null && Model.Speakers.Any())
                    {
                        <li><a href="#speakers">Speakers</a></li>
                    }

                    @if (Model.Sponsors != null && Model.Sponsors.Any())
                    {
                        <li><a href="#sponsors">Sponsors</a></li>
                    }

                    @if (Model.TicketTypes != null && Model.TicketTypes.Any())
                    {
                        <li><a href="#tickets">Tickets</a></li>
                    }

                    
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            <a class="btn-getstarted" href="#tickets">Book Now</a>

        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer dark-background">
        <div class="container">
            <div class="row gy-3">
                <div class="col-lg-4 col-md-6 d-flex">
                    <i class="bi bi-geo-alt icon"></i>
                    <div>
                        <h4>Location</h4>
                        <p>@Model.Location</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 d-flex">
                    <i class="bi bi-clock icon"></i>
                    <div>
                        <h4>Date & Time</h4>
                        <p>
                            <strong>Starts:</strong> <span>@Model.StartDate.ToString("MMM dd, yyyy HH:mm")</span>
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h4>Follow Us</h4>
                    <div class="social-links d-flex">
                        <a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>Copyright</span> <strong class="px-1 sitename">Eventus</strong> <span>All Rights Reserved</span></p>
            <div class="credits">
                Professional Event Management for <strong>@Model.Title</strong>
            </div>
        </div>
    </footer>

    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <div id="preloader"></div>

    <script src="~/Templates/Yummy/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Templates/Yummy/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/Templates/Yummy/assets/vendor/aos/aos.js"></script>
    <script src="~/Templates/Yummy/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/Templates/Yummy/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/Templates/Yummy/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <script src="~/Templates/Yummy/assets/js/main.js"></script>

</body>
</html>