@using EventManagementSystem.Web.Extensions
@using EventManagementSystem.Web.Models.Identity
@using Microsoft.AspNetCore.Identity
@using EventManagementSystem.Web.Data
@using Microsoft.EntityFrameworkCore
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context
@{
    var template = ViewBag.TemplateName as string;

    var orgInfo = await _context.OrganizationInfos.FirstOrDefaultAsync();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Eventus</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <link href="~/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    @* Nạp CSS động dựa trên template của sự kiện *@
    @{

        if (!string.IsNullOrEmpty(template))
        {
            <link href="~/Templates/@template/css/bootstrap.min.css" rel="stylesheet">
            <link href="~/Templates/@template/css/style.css" rel="stylesheet">
        }
        else
        {
            <link href="~/css/bootstrap.min.css" rel="stylesheet">
            <link href="~/css/style.css" rel="stylesheet">
        }
    }

    <style>
        :root {
            --primary: #00796B;
            --bs-primary: #00796B;
        }

        /* Đồng bộ toàn bộ font cho tất cả thẻ */
        body, h1, h2, h3, h4, h5, h6, .navbar-brand, .nav-link, .btn, p, span {
            font-family: 'Inter', sans-serif !important;
        }

        .text-primary {
            color: var(--primary) !important;
        }

        .btn-outline-primary {
            border-color: var(--primary);
            color: var(--primary);
        }

            .btn-outline-primary:hover {
                background-color: var(--primary);
                border-color: var(--primary);
            }
    </style>
</head>

<body>
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div class="container-fluid sticky-top">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-light border-bottom border-2 border-white">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                    <h1 class="mb-0 text-dark">Eventus</h1>
                </a>

                <button type="button" class="navbar-toggler ms-auto me-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav ms-auto">
                        @{
                            var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                        }

                        <a asp-controller="Home" asp-action="Index"
                           class="nav-item nav-link @(currentAction == "Index" ? "active" : "")">Home</a>

                        <a asp-controller="Home" asp-action="About"
                           class="nav-item nav-link @(currentAction == "About" ? "active" : "")">About</a>

                        <a asp-controller="Home" asp-action="Services"
                           class="nav-item nav-link @(currentAction == "Services" ? "active" : "")">Services</a>

                        <a asp-controller="Home" asp-action="Events"
                           class="nav-item nav-link @(currentAction == "Events" ? "active" : "")">Events</a>

                        <a asp-controller="Home" asp-action="Categories"
                           class="nav-item nav-link @(currentAction == "Categories" ? "active" : "")">Categories</a>

                        <a asp-controller="Home" asp-action="Contact"
                           class="nav-item nav-link @(currentAction == "Contact" ? "active" : "")">Contact</a>
                    </div>

                    <div class="d-flex align-items-center ms-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var userId = UserManager.GetUserId(User);
                            var unreadCount = _context.ContactInquiries
                            .Count(i => i.UserId == userId && i.IsReplied && !i.IsReadByAttendee);

                            @* Chuông thông báo *@
                            <a asp-controller="Support" asp-action="MyInquiries" class="nav-link position-relative me-3 p-0 text-dark">
                                <i class="bi bi-bell fs-4"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                          style="font-size: 0.6rem; padding: 0.35em 0.5em; margin-top: 5px;">
                                        @unreadCount
                                    </span>
                                }
                            </a>

                            @* Dropdown User *@
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle btn btn-outline-primary rounded-pill px-3" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i> Hello, @(User.Identity?.Name)
                                </a>
                                <div class="dropdown-menu bg-light rounded-0 rounded-bottom m-0 shadow">
                                    <a asp-controller="Manage" asp-action="Index" class="dropdown-item">My Profile</a>
                                    <a asp-controller="Manage" asp-action="MyEvents" class="dropdown-item text-nowrap">My Events</a>
                                    <a asp-controller="Support" asp-action="MyInquiries" class="dropdown-item">Support Inquiries</a>
                                    <div class="dropdown-divider"></div>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                            <i class="fas fa-power-off me-2"></i> Log Off
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            @* Cụm nút Login/Register khi Đăng xuất *@
                            <div class="d-flex">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill py-2 px-4 me-2">Log in</a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill py-2 px-4 text-white">Register</a>
                            </div>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </div>

    <div>
        @RenderBody()
    </div>

    @* Footer - Đã đổi sang Tag Helpers *@
    <div class="container-fluid bg-dark text-white-50 footer pt-5">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.1s">
                    <a href="@Url.Action("Index", "Home")" class="d-inline-block mb-3">
                        <h1 class="text-white">@(orgInfo?.OrganizationName ?? "Eventus")</h1>
                    </a>
                    <p class="mb-0">
                        @(orgInfo?.OrganizationBio ?? "Eventus – Smart event management solution. Effortlessly create your events.")
                    </p>
                </div>
                <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.3s">
                    <h5 class="text-white mb-4">Get In Touch</h5>
                    <p><i class="fa fa-map-marker-alt me-3"></i>@(orgInfo?.OrgAddress ?? "Your Address")</p>
                    <p><i class="fa fa-phone-alt me-3"></i>@(orgInfo?.OrgHotline ?? "Your Hotline")</p>
                    <p><i class="fa fa-envelope me-3"></i>@(orgInfo?.OrgEmail ?? "Your Email")</p>
                    <div class="d-flex pt-2">
                        <a class="btn btn-outline-primary btn-square border-2 me-2" href="#"><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-outline-primary btn-square border-2 me-2" href="#"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-outline-primary btn-square border-2 me-2" href="#"><i class="fab fa-youtube"></i></a>
                        <a class="btn btn-outline-primary btn-square border-2 me-2" href="#"><i class="fab fa-instagram"></i></a>
                        <a class="btn btn-outline-primary btn-square border-2 me-2" href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.5s">
                    <h5 class="text-white mb-4">Popular Link</h5>
                    <a class="btn btn-link" href="@Url.Action("About", "Home")">About Us</a>
                    <a class="btn btn-link" href="@Url.Action("Events", "Home")">Browse Events</a>
                    <a class="btn btn-link" href="@Url.Action("Categories", "Home")">Event Categories</a>
                    <a class="btn btn-link" href="@Url.Action("Contact", "Home")">Contact Us</a>
                    <a class="btn btn-link" href="#">Privacy Policy</a>
                </div>
                <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.7s">
                    <h5 class="text-white mb-4">Our Services</h5>
                    <a class="btn btn-link" href="@Url.Action("Services", "Home")">Event Planning</a>
                    <a class="btn btn-link" href="@Url.Action("Services", "Home")">Attendee Management</a>
                    <a class="btn btn-link" href="@Url.Action("Events", "Home")">Ticketing System</a>
                    <a class="btn btn-link" href="@Url.Action("Services", "Home")">Marketing & Promotion</a>
                    <a class="btn btn-link" href="@Url.Action("Contact", "Home")">Customer Support</a>
                </div>
            </div>
        </div>
        <div class="container wow fadeIn" data-wow-delay="0.1s">
            <div class="copyright">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        &copy; <a class="border-bottom" href="#">Eventus</a>, All Right Reserved.
                        Designed By ThemeEventus
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <div class="footer-menu">
                            <a href="@Url.Action("Index", "Home")">Home</a>
                            <a href="#">Cookies</a>
                            <a href="#">Help</a>
                            <a href="#">FAQs</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>

    @* Nạp Script động dựa trên template của sự kiện *@
    @{
        if (!string.IsNullOrEmpty(template))
        {
            <script src="~/Templates/@template/js/main.js"></script>
        }
        else
        {
            <script src="~/js/main.js"></script>
        }
    }


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>