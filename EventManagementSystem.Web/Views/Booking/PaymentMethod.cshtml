@using System.Globalization
@{
    Layout = "_Layout";
    // Switched to US culture for English currency formatting
    var culture = new CultureInfo("en-US");
}

<style>
    /* Synchronized Font and Global Styles */
    :root {
        --primary-font: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --brand-green: #006D5B;
    }

    body, .card, .btn, .form-control, label {
        font-family: var(--primary-font) !important;
    }

    .payment-item {
        cursor: pointer;
        transition: 0.3s;
    }

        .payment-item:hover {
            background-color: #f1f8f6;
            border-color: var(--brand-green) !important;
        }

        .payment-item input[type="radio"]:checked + img + div,
        .payment-item input[type="radio"]:checked + div + div {
            color: var(--brand-green);
        }

    .cursor-pointer {
        cursor: pointer;
    }

    .badge.bg-primary {
        background-color: var(--brand-green) !important;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h3 class="fw-bold mb-4 text-uppercase text-center">Checkout & Payment</h3>

            <div class="row g-4">
                @* Order Summary Section *@
                <div class="col-md-5">
                    <div class="card shadow-sm border-0 p-4" style="border-radius: 15px; background-color: #f8f9fa;">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">Order Summary</h5>

                        <div class="mb-3">
                            <label class="text-muted small d-block">Event</label>
                            <span class="fw-bold text-dark">@ViewBag.EventTitle</span>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small d-block">Customer Name</label>
                            <span class="fw-bold">@ViewBag.CustomerName</span>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small d-block">Email Address</label>
                            <span class="fw-bold">@ViewBag.CustomerEmail</span>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small d-block">Phone Number</label>
                            <span class="fw-bold">@ViewBag.PhoneNumber</span>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small d-block">Selected Seats</label>
                            <span class="badge bg-primary fs-6">@ViewBag.SelectedSeats</span>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <span class="fs-5 fw-bold">Total Amount</span>
                            @* Formatted as USD currency *@
                            <span class="fs-4 fw-bold text-danger">@ViewBag.TotalAmount.ToString("C", culture)</span>
                        </div>
                    </div>
                </div>

                @* Payment Method Selection Section *@
                <div class="col-md-7">
                    <div class="card shadow-sm border-0 p-4" style="border-radius: 15px;">
                        <h5 class="fw-bold mb-4">Select Payment Method</h5>

                        <form asp-action="ConfirmPayment" method="post">
                            <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                            <input type="hidden" name="customerName" value="@ViewBag.CustomerName" />
                            <input type="hidden" name="customerEmail" value="@ViewBag.CustomerEmail" />
                            <input type="hidden" name="phoneNumber" value="@ViewBag.PhoneNumber" />
                            <input type="hidden" name="selectedSeats" value="@ViewBag.SelectedSeats" />
                            <input type="hidden" name="totalAmount" value="@ViewBag.TotalAmount" />

                            <div class="payment-options d-flex flex-column gap-3">
                                @* MoMo E-Wallet *@
                                <label class="payment-item p-3 border rounded d-flex align-items-center cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="MoMo" class="me-3" checked>
                                    <img src="https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png" width="40" class="rounded me-3" alt="MoMo">
                                    <div>
                                        <div class="fw-bold">MoMo E-Wallet</div>
                                        <small class="text-muted">Fast payment via MoMo app</small>
                                    </div>
                                </label>

                                @* Bank Transfer *@
                                <label class="payment-item p-3 border rounded d-flex align-items-center cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="BankTransfer" class="me-3">
                                    <div class="bg-light rounded p-2 me-3">
                                        <i class="fa fa-university text-success fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Bank Transfer</div>
                                        <small class="text-muted">Scan QR code for instant transfer</small>
                                    </div>
                                </label>

                                @* Credit/Debit Card *@
                                <label class="payment-item p-3 border rounded d-flex align-items-center cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="CreditCard" class="me-3">
                                    <div class="bg-light rounded p-2 me-3">
                                        <i class="fa fa-credit-card text-primary fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">International Cards (Visa/Mastercard)</div>
                                        <small class="text-muted">Supports all major international banks</small>
                                    </div>
                                </label>
                            </div>

                            <div class="mt-5 d-flex gap-3">
                                <a asp-action="BookingProcess" asp-route-id="@ViewBag.EventId" class="btn btn-outline-secondary w-100 py-3 fw-bold">
                                    GO BACK
                                </a>
                                <button type="submit" class="btn btn-success w-100 py-3 fw-bold shadow-sm" style="background-color: var(--brand-green); border: none;">
                                    CONFIRM PAYMENT
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>