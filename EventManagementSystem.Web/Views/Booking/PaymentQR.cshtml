@model EventManagementSystem.Web.Models.Entities.Booking
@{
    Layout = "_Layout";
}

<style>
    :root {
        --primary-font: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body, .card, .btn, .alert, h4, h6, form, button {
        font-family: var(--primary-font) !important;
    }
</style>

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow border-0 p-4 text-center" style="max-width: 600px; border-radius: 20px;">
        <div class="mb-3">
            <div class="bg-success d-inline-block rounded-circle p-2 text-white">
                <i class="fa fa-check fs-4"></i>
            </div>
        </div>

        <h4 class="fw-bold">Scan QR Code to Pay</h4>
        <p class="text-muted small">Use your banking app or e-wallet to scan the QR code</p>

        <div class="qr-box my-4 p-3 border rounded shadow-sm d-inline-block mx-auto">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=PAYMENT_BOOKING_@ViewBag.BookingId"
                 alt="Payment QR" class="img-fluid" style="width: 250px;" />
        </div>

        <div class="instruction-box alert alert-primary text-start small mb-4" style="background-color: #f0f7ff; border: none;">
            <h6 class="fw-bold mb-2 text-primary">Payment Instructions:</h6>
            <ol class="mb-0">
                <li>Open your banking or e-wallet app</li>
                <li>Select the QR Scan feature</li>
                <li>Scan the QR code displayed above</li>
                <li>Verify the information and complete the payment</li>
                <li>Individual tickets will be sent to your email after confirmation</li>
            </ol>
        </div>

        <div class="payment-info bg-light p-3 rounded mb-4">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted small">Method:</span>
                <span class="fw-bold">@ViewBag.PaymentMethod</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted small">Seats:</span>
                <span class="fw-bold text-success">@ViewBag.SelectedSeats</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted small">Total Amount:</span>
                <span class="fw-bold text-primary fs-5">$@ViewBag.TotalAmount.ToString("N2")</span>
            </div>
        </div>

        <div class="d-flex gap-2">
            @* Thay đổi nút Back thành Form POST để xóa dữ liệu Pending *@
            <form asp-action="RollbackAndChangeMethod" method="post" class="w-50">
                <input type="hidden" name="bookingId" value="@ViewBag.BookingId" />
                <button type="submit" class="btn btn-outline-secondary w-100 py-2">
                    ← Change Method
                </button>
            </form>

            <form asp-action="FinalizeBooking" method="post" class="w-50">
                <input type="hidden" name="bookingId" value="@ViewBag.BookingId" />
                <input type="hidden" name="selectedSeats" value="@ViewBag.SelectedSeats" />
                <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="background-color: #006D5B; border: none;">
                    Confirm Payment Done
                </button>
            </form>
        </div>
    </div>
</div>