@{
    ViewData["Title"] = "Thank You";
}

<div class="container py-5 text-center" style="font-family: 'Arimo', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <i class="bi bi-heart-fill text-danger" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold text-dark">Thank You!</h2>
                <p class="text-muted mb-4">
                    Your review has been submitted successfully.
                    We truly appreciate your time and feedback.
                </p>
                <div class="d-grid gap-2">
                    <a href="/" class="btn btn-primary rounded-pill py-2 fw-bold">
                        Continue Exploring
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>