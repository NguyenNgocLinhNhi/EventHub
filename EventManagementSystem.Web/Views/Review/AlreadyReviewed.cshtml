@{
    ViewData["Title"] = "Already Reviewed";
}

<div class="container py-5 text-center" style="font-family: 'Arimo', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <i class="bi bi-info-circle-fill text-info" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold text-dark">Already Submitted</h2>
                <p class="text-muted mb-4">
                    You have already shared your feedback for this event.
                    Thank you for helping us improve!
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="Manage" asp-action="MyReviews" class="btn btn-primary rounded-pill py-2 fw-bold">
                        View My Reviews
                    </a>
                    <a href="/" class="btn btn-light rounded-pill py-2 text-muted">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>