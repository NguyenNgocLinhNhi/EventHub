@model EventManagementSystem.Web.Models.Entities.Review
@{
    ViewData["Title"] = "Rate Event";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&display=swap" rel="stylesheet">

<div class="container py-5" style="font-family: 'Arimo', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-4 text-center border-0">
                    <i class="bi bi-star-fill text-warning fs-1 mb-2"></i>
                    <h2 class="fw-bold text-white mb-0">Event Feedback</h2>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <p class="text-muted">How was your experience at</p>
                        <h4 class="fw-bold text-dark">@ViewBag.EventTitle</h4>
                    </div>

                    <form asp-action="Create" method="post" id="reviewForm">
                        <input type="hidden" asp-for="EventId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-muted">Email Address</label>
                            <input asp-for="CustomerEmail" class="form-control rounded-3 bg-light"
                                   readonly="readonly" tabindex="-1" />
                            <small class="text-muted" style="font-size: 0.7rem;">Your review will be linked to this email.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Full Name</label>
                            <input asp-for="CustomerName" class="form-control rounded-3 @(User.Identity.IsAuthenticated ? "bg-light" : "")"
                                   placeholder="Enter your name" required
                                   readonly="@(User.Identity.IsAuthenticated ? "readonly" : null)" />
                            @if (User.Identity.IsAuthenticated)
                            {
                                <small class="text-success" style="font-size: 0.7rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Verified account info
                                </small>
                            }
                        </div>

                        <hr class="my-4 opacity-50">

                        <div class="mb-4 text-center">
                            <label class="form-label d-block fw-bold mb-3">Your Overall Rating</label>
                            <div class="star-rating">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" id="star@i" asp-for="Rating" value="@i" />
                                    <label for="star@i" class="bi bi-star-fill" title="@i stars"></label>
                                }
                            </div>
                            <span asp-validation-for="Rating" class="text-danger small d-block mt-2"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Detailed Feedback</label>
                            <textarea asp-for="Comment" class="form-control rounded-4 p-3" rows="4"
                                      placeholder="What did you enjoy most? What can we improve?"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm transition-all">
                            <i class="bi bi-send-fill me-2"></i>Submit My Review
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Homepage
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styling cho hệ thống Star Rating */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 12px;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            font-size: 2.8rem;
            color: #e9ecef;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
        }

            /* Hiệu ứng Hover và Checked */
            .star-rating label:hover,
            .star-rating label:hover ~ label,
            .star-rating input:checked ~ label {
                color: #ffc107;
                transform: scale(1.1);
            }

            .star-rating label:active {
                transform: scale(0.9);
            }

    /* Tùy chỉnh Input Form */
    .form-control {
        border: 1px solid #dee2e6;
        padding: 0.75rem 1rem;
    }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
        }

        .form-control[readonly] {
            cursor: default;
        }

    /* Hiệu ứng nút bấm */
    .transition-all {
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3) !important;
    }
</style>