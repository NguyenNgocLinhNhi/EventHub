@model EventManagementSystem.Web.ViewModels.ContactFormModel
@{
    ViewData["Title"] = "Contact Us";
}

<style>
    /* Nâng cấp hiệu ứng đồ họa */
    .contact-overlay-card {
        margin-top: -50px; /* Tạo hiệu ứng thẻ đè lên Hero Header */
        z-index: 10;
        position: relative;
    }

    .info-item {
        transition: all 0.3s ease;
        border-radius: 1.5rem;
        background: #ffffff;
    }

        .info-item:hover {
            background: var(--primary);
            color: white !important;
        }

            .info-item:hover .icon-circle {
                background: white;
                color: var(--primary);
            }

    .icon-circle {
        width: 50px;
        height: 50px;
        background: rgba(0, 121, 107, 0.1);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    /* Đổi border sang bên trái cho cột Form */
    .form-section {
        border-left: 1px solid #eee;
    }

    .working-hours-label {
        font-size: 0.75rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #6c757d;
    }
</style>

@* --- HERO HEADER --- *@
<div class="container-fluid pb-5 bg-primary hero-header mb-5">
    <div class="container py-5">
        <div class="row g-3 align-items-center">
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-1 mb-0 animated slideInLeft text-dark">Contact</h1>
            </div>
            <div class="col-lg-6 animated slideInRight">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a class="text-muted" asp-controller="Home" asp-action="Index" style="text-decoration: none;">Home</a>
                        </li>
                        <li class="breadcrumb-item text-primary active" aria-current="page">Contact</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        @* --- THẺ NỔI CHÍNH (FLOATING CARD) --- *@
        <div class="contact-overlay-card bg-white rounded-4 shadow-lg overflow-hidden wow fadeInUp" data-wow-delay="0.1s">
            <div class="row g-0">

                @* Cột 1: Thông tin bổ sung & Giờ làm việc (BÊN TRÁI) *@
                <div class="col-lg-5 p-5 bg-light d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="fw-bold mb-4">Get in Touch</h3>
                        <p class="text-muted mb-5">Have specific questions about an event? Reach out to us through any of these channels.</p>

                        <div class="mb-4">
                            <div class="working-hours-label mb-2">Support Hours</div>
                            <p class="mb-0 fw-bold text-dark">Monday - Friday: 08:00 - 18:00</p>
                            <p class="mb-0 text-muted">Weekend: Closed</p>
                        </div>

                        <div class="d-grid gap-3">
                            <div class="info-item p-3 border shadow-sm d-flex align-items-center">
                                <div class="icon-circle me-3"><i class="bi bi-chat-left-dots"></i></div>
                                <div><small class="text-muted d-block">Live Chat</small><span class="fw-bold">Available 24/7</span></div>
                            </div>
                            <div class="info-item p-3 border shadow-sm d-flex align-items-center">
                                <div class="icon-circle me-3"><i class="bi bi-telephone"></i></div>
                                <div><small class="text-muted d-block">Call Us</small><span class="fw-bold">+84 901 234 567</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        <h6 class="text-muted small mb-3">Follow our updates</h6>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="#" class="text-primary fs-4"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-primary fs-4"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="text-primary fs-4"><i class="bi bi-twitter"></i></a>
                        </div>
                    </div>
                </div>

                @* Cột 2: Form liên hệ (BÊN PHẢI) *@
                <div class="col-lg-7 p-5 form-section bg-white">
                    <h3 class="fw-bold mb-4">Send a Message</h3>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Contact" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="EventId" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control border-0 bg-light" placeholder="Name"
                                           readonly="@User.Identity.IsAuthenticated">
                                    <label asp-for="Name">Full Name</label>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control border-0 bg-light" placeholder="Email"
                                           readonly="@User.Identity.IsAuthenticated">
                                    <label asp-for="Email">Email Address</label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Message" class="form-control border-0 bg-light" placeholder="Message" style="height: 160px"></textarea>
                                    <label asp-for="Message">How can we help you today?</label>
                                    <span asp-validation-for="Message" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow">
                                    Submit Request <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@* --- BẢN ĐỒ FULL-WIDTH --- *@
<div class="container-fluid p-0 mt-5 wow fadeIn" data-wow-delay="0.1s">
    <div style="height: 400px;">
        <iframe class="w-100 h-100 border-0"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.123456789012!2d106.6987654321!3d10.7765432109!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTDCsDQ2JzM1LjUiTiAxMDbCsDQxJzU1LjYiRQ!5e0!3m2!1svi!2svn!4v1234567890123"
                allowfullscreen="" loading="lazy"></iframe>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}