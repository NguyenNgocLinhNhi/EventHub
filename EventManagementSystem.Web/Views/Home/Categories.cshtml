@model IEnumerable<EventManagementSystem.Web.Models.Entities.Category>

@{
    ViewData["Title"] = "Event Categories";
    Layout = "_Layout";
}

@* Section 1: Hero Header *@
<div class="container-fluid pb-5 bg-primary hero-header mb-5">
    <div class="container py-5">
        <div class="row g-3 align-items-center">
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-1 mb-0 animated slideInLeft text-dark">Categories</h1>
            </div>
            <div class="col-lg-6 animated slideInRight">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a class="text-muted" asp-controller="Home" asp-action="Index" style="text-decoration: none;">Home</a>
                        </li>
                        <li class="breadcrumb-item text-primary active" aria-current="page">Categories</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

@* Section 2: Categories List *@
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h6 class="text-primary section-title bg-white text-center px-3">Categories</h6>
            <h1 class="display-6 mb-4">Explore Events by Category</h1>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var category in Model)
                {
                    @* Bây giờ chúng ta lấy trực tiếp category.Name và category.Description từ DB *@
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="service-item text-center pt-3 shadow-sm rounded-4 border bg-white h-100">
                            <div class="p-4">
                                <i class="fa fa-3x fa-calendar-check text-primary mb-4"></i>
                                <h5 class="mb-3">@category.Name</h5>
                                <p class="text-muted small">@category.Description</p>

                                <a class="btn btn-outline-primary rounded-pill px-4 mt-2"
                                   asp-controller="Home"
                                   asp-action="Events"
                                   asp-route-categoryId="@category.Id">View Events</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">No categories available.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .rounded-4 {
        border-radius: 1.5rem !important;
    }

    .service-item {
        transition: .5s;
    }

        .service-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>