@using EventManagementSystem.Web.ViewModels
@model HomeViewModel
@{
    ViewBag.Title = "Explore Events & Experiences - Eventus";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Countdown logic for Spotlight
    var timeSpan = Model.SpotlightEvent != null ? Model.SpotlightEvent.StartDate - DateTime.Now : TimeSpan.Zero;
    var daysLeft = timeSpan.Days > 0 ? timeSpan.Days : 0;
    var hoursLeft = timeSpan.Hours > 0 ? timeSpan.Hours : 0;

    // Minimum price logic - Sửa lỗi Null và gán dữ liệu từ Model
    var minPrice = Model.SpotlightEvent != null && Model.SpotlightEvent.TicketTypes != null && Model.SpotlightEvent.TicketTypes.Any()
                   ? Model.SpotlightEvent.TicketTypes.Min(t => t.Price).ToString("N0")
                   : "Contact Us";
}

<main>
    @*Section 1: Hero Header*@
    <div class="container-fluid pb-5 hero-header bg-light mb-5">
        <div class="container py-5">
            <div class="row g-5 align-items-center mb-5">
                <div class="col-lg-6">
                    <h1 class="display-4 mb-4 animated slideInRight">
                        Discover <span class="text-primary">Events</span> & Unforgettable Experiences
                    </h1>
                    <p class="mb-4 animated slideInRight text-muted lead">
                        From massive music festivals to exclusive tech summits and local workshops. Find your next adventure and book your tickets in seconds!
                    </p>

                    <div class="bg-white rounded p-3 shadow-sm border animated slideInRight mb-4" style="border-radius: 50px !important;">
                        <form action="@Url.Action("Events", "Home")" method="get">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="searchString" class="form-control border-0 shadow-none" placeholder="Search events, artists, or venues...">
                                <button class="btn btn-primary px-4 rounded-pill" type="submit">Search</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="owl-carousel header-carousel animated fadeIn">
                        @* Vibrant Concert *@
                        <img class="img-fluid rounded shadow" src="https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?auto=format&fit=crop&w=800&q=80" alt="Concert Life">
                        @* Tech Conference *@
                        <img class="img-fluid rounded shadow" src="https://media.istockphoto.com/id/2174406748/photo/woman-is-presenting-a-phone.jpg?s=612x612&w=0&k=20&c=ccnWslGUMEonLey8OWp3RDNFESYUg_ST0WuFQQSBwQE=" alt="Tech Conference">
                        @* Elegant Gala *@
                        <img class="img-fluid rounded shadow" src="https://eagleviewbh.com/wp-content/uploads/2025/12/New-Year-Celebration-1000-x-667-px.jpg?auto=format&fit=crop&w=800&q=80" alt="Corporate Gala">
                    </div>
                </div>
            </div>

            @* Trust Badges *@
            <div class="row g-5 animated fadeIn">
                <div class="col-md-6 col-lg-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 btn-square border border-2 border-white me-3 bg-white text-primary rounded-circle shadow-sm">
                            <i class="fa fa-ticket-alt"></i>
                        </div>
                        <div>
                            <h5 class="lh-base mb-0">Smart Tickets</h5>
                            <small class="text-muted">Instant QR Delivery</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 btn-square border border-2 border-white me-3 bg-white text-primary rounded-circle shadow-sm">
                            <i class="fa fa-shield-alt"></i>
                        </div>
                        <div>
                            <h5 class="lh-base mb-0">Secure Pay</h5>
                            <small class="text-muted">Encrypted Checkout</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 btn-square border border-2 border-white me-3 bg-white text-primary rounded-circle shadow-sm">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div>
                            <h5 class="lh-base mb-0">Verified Only</h5>
                            <small class="text-muted">Official Organizers</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 btn-square border border-2 border-white me-3 bg-white text-primary rounded-circle shadow-sm">
                            <i class="fa fa-headset"></i>
                        </div>
                        <div>
                            <h5 class="lh-base mb-0">Expert Help</h5>
                            <small class="text-muted">24/7 Dedicated Support</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*Section 2: Browse by Category (Circle Style)*@
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                <h6 class="text-primary section-title bg-white text-center px-3">Interests</h6>
                <h1 class="display-6 mb-4">Explore Events by Category</h1>
            </div>

            <div class="row g-4 justify-content-center">
                @* Technology *@
                <div class="col-lg-2 col-md-3 col-6 text-center wow fadeInUp" data-wow-delay="0.1s">
                    <a asp-controller="Home" asp-action="Events" asp-route-searchString="Technology" class="cat-circle d-block text-decoration-none">
                        <div class="circle-img mb-3 mx-auto position-relative overflow-hidden shadow-sm">
                            <img class="img-fluid w-100 h-100" src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=300&q=80" alt="Tech">
                        </div>
                        <h6 class="mb-0 text-dark fw-bold">Technology</h6>
                    </a>
                </div>

                @* Music *@
                <div class="col-lg-2 col-md-3 col-6 text-center wow fadeInUp" data-wow-delay="0.2s">
                    <a asp-controller="Home" asp-action="Events" asp-route-searchString="Music" class="cat-circle d-block text-decoration-none">
                        <div class="circle-img mb-3 mx-auto position-relative overflow-hidden shadow-sm">
                            <img class="img-fluid w-100 h-100" src="https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=300&q=80" alt="Music">
                        </div>
                        <h6 class="mb-0 text-dark fw-bold">Music</h6>
                    </a>
                </div>

                @* Food *@
                <div class="col-lg-2 col-md-3 col-6 text-center wow fadeInUp" data-wow-delay="0.3s">
                    <a asp-controller="Home" asp-action="Events" asp-route-searchString="Food" class="cat-circle d-block text-decoration-none">
                        <div class="circle-img mb-3 mx-auto position-relative overflow-hidden shadow-sm">
                            <img class="img-fluid w-100 h-100" src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=300&q=80" alt="Food">
                        </div>
                        <h6 class="mb-0 text-dark fw-bold">Food & Drink</h6>
                    </a>
                </div>

                @* Education *@
                <div class="col-lg-2 col-md-3 col-6 text-center wow fadeInUp" data-wow-delay="0.4s">
                    <a asp-controller="Home" asp-action="Events" asp-route-searchString="Education" class="cat-circle d-block text-decoration-none">
                        <div class="circle-img mb-3 mx-auto position-relative overflow-hidden shadow-sm">
                            <img class="img-fluid w-100 h-100" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ_BUqXbr84hNp5b6D19Fggg0KP371VJVA0Jw&s" alt="Education">
                        </div>
                        <h6 class="mb-0 text-dark fw-bold">Education</h6>
                    </a>
                </div>

                @* Business *@
                <div class="col-lg-2 col-md-3 col-6 text-center wow fadeInUp" data-wow-delay="0.5s">
                    <a asp-controller="Home" asp-action="Events" asp-route-searchString="Business" class="cat-circle d-block text-decoration-none">
                        <div class="circle-img mb-3 mx-auto position-relative overflow-hidden shadow-sm">
                            <img class="img-fluid w-100 h-100" src="https://plus.unsplash.com/premium_photo-1661772661721-b16346fe5b0f?w=700&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8YnVzaW5lc3N8ZW58MHx8MHx8fDA%3D" alt="Business">
                        </div>
                        <h6 class="mb-0 text-dark fw-bold">Business</h6>
                    </a>
                </div>

                @* Health/Wellness *@
                <div class="col-lg-2 col-md-3 col-6 text-center wow fadeInUp" data-wow-delay="0.6s">
                    <a asp-controller="Home" asp-action="Events" asp-route-searchString="Health" class="cat-circle d-block text-decoration-none">
                        <div class="circle-img mb-3 mx-auto position-relative overflow-hidden shadow-sm">
                            <img class="img-fluid w-100 h-100" src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=300&q=80" alt="Health">
                        </div>
                        <h6 class="mb-0 text-dark fw-bold">Wellness</h6>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @*Section 3: Spotlight Event (Cập nhật dữ liệu từ Model)*@
    @if (Model.SpotlightEvent != null)
    {
        <div class="container-fluid bg-dark py-5 my-5 wow fadeIn" data-wow-delay="0.1s"
             style="background: linear-gradient(to right, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.7)), url('@Model.SpotlightEvent.ImageUrl'); background-size: cover; background-position: center;">
            <div class="container py-5">
                <div class="row align-items-center">
                    <div class="col-lg-6 text-white">
                        <div class="badge bg-danger text-uppercase px-3 py-2 mb-4">Featured Highlight</div>
                        <h1 class="display-4 text-white mb-3">@Model.SpotlightEvent.Title</h1>

                        <div class="d-flex align-items-center mb-4">
                            <span class="me-4"><i class="fa fa-calendar-alt text-primary me-2"></i>@Model.SpotlightEvent.StartDate.ToString("MMM dd, yyyy")</span>
                            <span><i class="fa fa-map-marker-alt text-primary me-2"></i>@Model.SpotlightEvent.Location</span>
                        </div>

                        <p class="mb-4 text-white-50 lead">
                            @(Model.SpotlightEvent.Description?.Length > 200 ? Model.SpotlightEvent.Description.Substring(0, 200) + "..." : Model.SpotlightEvent.Description)
                        </p>

                        <div class="row g-3 mb-4 text-center">
                            <div class="col-3">
                                <div class="bg-white text-dark rounded p-2">
                                    <h3 class="mb-0 fw-bold">@daysLeft</h3>
                                    <small>Days</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="bg-white text-dark rounded p-2">
                                    <h3 class="mb-0 fw-bold">@hoursLeft</h3>
                                    <small>Hours</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="bg-white text-dark rounded p-2">
                                    <h3 class="mb-0 fw-bold">HOT</h3>
                                    <small>Booking</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <a href="@Url.Action("Detail", "Event", new { id = Model.SpotlightEvent.Id })" class="btn btn-primary py-3 px-5 fw-bold">Book Tickets Now <i class="fa fa-arrow-right ms-2"></i></a>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @*Section 4: Suggestions*@
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                <h6 class="text-primary section-title bg-white text-center px-3">Curated Collections</h6>
                <h1 class="display-6 mb-4">What's Your Vibe Today?</h1>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <a href="#" class="collection-item position-relative d-block overflow-hidden rounded shadow-sm">
                        <img class="img-fluid w-100" src="https://thumbs.dreamstime.com/b/have-great-weekend-text-alarm-clock-wooden-background-390989017.jpg?w=768" alt="Weekend" style="height: 320px; object-fit: cover;">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4"
                             style="background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);">
                            <h4 class="text-white mb-1">Nightlife & Music</h4>
                            <p class="text-white-50 mb-0 small">Explore concerts and clubs <i class="fa fa-arrow-right ms-2"></i></p>
                        </div>
                    </a>
                </div>

                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <a href="#" class="collection-item position-relative d-block overflow-hidden rounded shadow-sm">
                        <img class="img-fluid w-100" src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=800&q=80" alt="Learning" style="height: 320px; object-fit: cover;">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4"
                             style="background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);">
                            <h4 class="text-white mb-1">Skill Workshops</h4>
                            <p class="text-white-50 mb-0 small">Learn something new today</p>
                        </div>
                    </a>
                </div>

                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                    <a href="#" class="collection-item position-relative d-block overflow-hidden rounded shadow-sm">
                        <img class="img-fluid w-100" src="https://images.unsplash.com/photo-1523580494863-6f3031224c94?auto=format&fit=crop&w=800&q=80" alt="Gala" style="height: 320px; object-fit: cover;">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4"
                             style="background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);">
                            <h4 class="text-white mb-1">Corporate & Networking</h4>
                            <p class="text-white-50 mb-0 small">Expand your professional circle</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @*Section 5: Process*@
    <div class="container-xxl py-5 bg-light my-5 rounded-5">
        <div class="container py-5">
            <div class="text-center mx-auto mb-5" style="max-width: 600px;">
                <h6 class="text-primary text-uppercase fw-bold">Simple Steps</h6>
                <h1 class="display-6 mb-4">Your Path to the Event</h1>
            </div>
            <div class="row g-4 text-center">
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 border-top border-primary border-4">
                        <i class="bi bi-search fs-1 text-primary mb-3"></i>
                        <h5>1. Discover</h5>
                        <p class="text-muted small mb-0">Browse through thousands of events across various categories.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 border-top border-primary border-4">
                        <i class="bi bi-ticket-perforated fs-1 text-primary mb-3"></i>
                        <h5>2. Select Tickets</h5>
                        <p class="text-muted small mb-0">Choose your seating, ticket type, and add to your cart.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 border-top border-primary border-4">
                        <i class="bi bi-credit-card fs-1 text-primary mb-3"></i>
                        <h5>3. Fast Checkout</h5>
                        <p class="text-muted small mb-0">Secure payment with local and international methods.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 bg-white rounded-4 shadow-sm h-100 border-top border-primary border-4">
                        <i class="bi bi-qr-code-scan fs-1 text-primary mb-3"></i>
                        <h5>4. Get QR Code</h5>
                        <p class="text-muted small mb-0">Scan your digital ticket at the entrance. No printing needed.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*Section 7: Testimonials*@
    <div class="container-xxl py-5">
        <div class="container py-5">
            <div class="text-center mx-auto mb-5" style="max-width: 600px;">
                <h1 class="display-6 mb-4">Attendee Stories</h1>
                <p class="text-muted">Real experiences from our community of event-goers.</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="owl-carousel testimonial-carousel">
                        <div class="testimonial-item bg-white p-5 rounded shadow-sm border mx-2">
                            <div class="d-flex align-items-center mb-4">
                                <img class="img-fluid rounded-circle border p-1" src="https://i.pravatar.cc/150?u=jane" style="width: 70px; height: 70px;" alt="Jane">
                                <div class="ms-3">
                                    <h5 class="mb-1">Sarah Jenkins</h5>
                                    <small class="text-primary">Art Director</small>
                                </div>
                            </div>
                            <p class="mb-0 italic">"Booking tickets through Eventus was incredibly smooth. I received my QR code via email instantly, and the check-in at the gala was faster than I've ever experienced!"</p>
                        </div>
                        <div class="testimonial-item bg-white p-5 rounded shadow-sm border mx-2">
                            <div class="d-flex align-items-center mb-4">
                                <img class="img-fluid rounded-circle border p-1" src="https://i.pravatar.cc/150?u=mike" style="width: 70px; height: 70px;" alt="Mike">
                                <div class="ms-3">
                                    <h5 class="mb-1">Michael Chen</h5>
                                    <small class="text-primary">Developer</small>
                                </div>
                            </div>
                            <p class="mb-0 italic">"I never miss a tech summit because of this platform. The search filters are great, and the 'Free Events' section is a goldmine for networking!"</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*Section 8: Newsletter*@
    <div class="container-fluid bg-primary newsletter p-0">
        <div class="container p-0">
            <div class="row g-0 align-items-center">
                <div class="col-md-5 ps-lg-0 text-start wow fadeIn" data-wow-delay="0.2s">
                    <img class="img-fluid w-100" src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=800&q=80" alt="Newsletter">
                </div>
                <div class="col-md-7 py-5 newsletter-text wow fadeIn" data-wow-delay="0.5s">
                    <div class="p-5">
                        <h1 class="mb-5">
                            Subscribe to Our <span class="text-uppercase text-primary bg-white px-2">Newsletter</span>
                        </h1>
                        <div class="position-relative w-100 mb-2">
                            <input class="form-control border-0 w-100 ps-4 pe-5" type="text"
                                   placeholder="Enter your email address" style="height: 60px;">
                            <button type="button" class="btn shadow-none position-absolute top-0 end-0 mt-2 me-2">
                                <i class="fa fa-paper-plane text-primary fs-4"></i>
                            </button>
                        </div>
                        <small class="text-white-50">Don't miss out on the latest updates and exclusive offers.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    /* Styling for the circular category images */
    .circle-img {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        border: 4px solid #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

        .circle-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .cat-circle:hover .circle-img {
        transform: scale(1.08);
        box-shadow: 0 12px 25px rgba(0,121,107,0.2) !important;
        border-color: var(--primary) !important;
    }

    .collection-item {
        overflow: hidden;
        border-radius: 1.5rem;
    }

        .collection-item img {
            transition: 0.6s ease;
        }

        .collection-item:hover img {
            transform: scale(1.1);
        }

    .rounded-5 {
        border-radius: 3rem !important;
    }

    .rounded-4 {
        border-radius: 1.5rem !important;
    }
</style>